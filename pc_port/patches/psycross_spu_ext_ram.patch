+// area, SpuMalloc heap) stays within kSpuRamSize; only transfers and voice
+// addresses reach past it.
+const uint32_t kSpuExtRamSize     = 2048u * 1024u;
 const int      kNumVoices         = 24;           // 24 hardware voices
