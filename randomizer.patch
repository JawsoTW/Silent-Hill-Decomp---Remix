diff --git a/pc_port/launcher/SilentHillPC_Remix/app.manifest b/pc_port/launcher/SilentHillPC_Remix/app.manifest
new file mode 100644
index 0000000..8089cb6
--- /dev/null
+++ b/pc_port/launcher/SilentHillPC_Remix/app.manifest
@@ -0,0 +1,47 @@
+<?xml version="1.0" encoding="utf-8"?>
+<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
+  <!-- A real, stable application manifest reduces antivirus false-positive
+       weight: it declares a fixed application identity, requests only normal
+       user rights (asInvoker, NOT elevation), and lists supported OS versions.
+       Unsigned .NET exes with no manifest score higher on ML heuristics. -->
+  <assemblyIdentity version="1.0.0.0" name="SilentHillPC.Remix" type="win32" />
+
+  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
+    <security>
+      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
+        <!-- asInvoker: the launcher never needs admin. Requesting elevation
+             (requireAdministrator) is itself a heuristic red flag. -->
+        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
+      </requestedPrivileges>
+    </security>
+  </trustInfo>
+
+  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
+    <application>
+      <!-- Windows 10/11 -->
+      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
+      <!-- Windows 8.1 -->
+      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
+      <!-- Windows 8 -->
+      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
+      <!-- Windows 7 -->
+      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
+    </application>
+  </compatibility>
+
+  <application xmlns="urn:schemas-microsoft-com:asm.v3">
+    <windowsSettings>
+      <!-- MUST stay false: the forms are fixed-pixel layouts designed at 96
+           DPI. dpiAware=true (added 09c353a72 for AV heuristics) stopped
+           Windows' bitmap-stretch virtualization on scaled displays — fonts
+           grew but the layout didn't, clipping every control. false restores
+           the pre-manifest behavior (whole window scaled by Windows). -->
+      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">false</dpiAware>
+      <!-- Opt in to Win10 long-path support (with the OS LongPathsEnabled
+           policy) so non-\\?\ Win32 ops also survive >MAX_PATH texture-pack
+           paths; the DdsConverter shuffle works without it, this is a
+           belt-and-braces layer. -->
+      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
+    </windowsSettings>
+  </application>
+</assembly>
