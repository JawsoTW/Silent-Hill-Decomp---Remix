diff --git a/pc_port/maps/CMakeLists.txt b/pc_port/maps/CMakeLists.txt
index 9326c46..82c143c 100644
--- a/pc_port/maps/CMakeLists.txt
+++ b/pc_port/maps/CMakeLists.txt
@@ -182,6 +182,18 @@ function(add_map_overlay MAP_NAME MAP_DEFINE)
         # Build ordering only (the exe must exist to dlopen the map); there is
         # no link-time dependency on the executable.
         add_dependencies(${MAP_NAME} SilentHillPC)
+        # A map DLL's own imports resolve from the exe's directory; make sure
+        # any runtime DLL it needs that the exe doesn't is copied there too.
+        if(MINGW AND SH_MINGW_OBJDUMP)
+            add_custom_command(TARGET ${MAP_NAME} POST_BUILD
+                COMMAND ${CMAKE_COMMAND}
+                        "-DBINARY=$<TARGET_FILE:SilentHillPC>"
+                        "-DEXTRA_GLOB=$<TARGET_FILE:${MAP_NAME}>"
+                        "-DSEARCH_DIR=${SH_MINGW_BIN}"
+                        "-DOBJDUMP=${SH_MINGW_OBJDUMP}"
+                        -P "${CMAKE_SOURCE_DIR}/cmake/copy_mingw_runtime.cmake"
+                VERBATIM)
+        endif()
         if(APPLE)
             # ld64 (unlike GNU ld) errors on undefined symbols at link time.
             # Game-code symbols are resolved from the main exe at dlopen, so
diff --git a/pc_port/patches/psycross_spu_ext_ram.patch b/pc_port/patches/psycross_spu_ext_ram.patch
new file mode 100644
index 0000000..f58154b
--- /dev/null
+++ b/pc_port/patches/psycross_spu_ext_ram.patch
@@ -0,0 +1,125 @@
+diff --git a/src/audio/PsyX_SPUCore.cpp b/src/audio/PsyX_SPUCore.cpp
+index 162e78a..1db66e3 100644
+--- a/src/audio/PsyX_SPUCore.cpp
++++ b/src/audio/PsyX_SPUCore.cpp
+@@ -117,6 +117,7 @@ static inline int16_t SaturateS16(int32_t v)
+ // ---------------------------------------------------------------------------
+ 
+ SPUCore::SPUCore()
++    : m_ramStore(kSpuExtRamSize), m_ram(m_ramStore.data())
+ {
+     Reset();
+ }
+@@ -131,7 +132,7 @@ void SPUCore::ResetVoice(SPUVoiceState& v)
+ 
+ void SPUCore::Reset()
+ {
+-    memset(m_ram, 0, sizeof(m_ram));
++    memset(m_ram, 0, kSpuExtRamSize);
+ 
+     for (int i = 0; i < kNumVoices; ++i)
+     {
+@@ -190,7 +191,7 @@ void SPUCore::Reset()
+ 
+ uint32_t SPUCore::SetTransferStartAddr(uint32_t addr)
+ {
+-    m_transferStartAddr = addr & (kSpuRamSize - 1u);
++    m_transferStartAddr = addr & (kSpuExtRamSize - 1u);
+     m_transferCurAddr = m_transferStartAddr;
+     return m_transferStartAddr;
+ }
+@@ -220,7 +221,7 @@ u_int SPUCore::Write(const u_char* src, u_int sizeBytes)
+     if (m_transferMode == TransferMode::Stop)
+         return 0;
+ 
+-    u_int remaining = (m_transferCurAddr < kSpuRamSize) ? (kSpuRamSize - m_transferCurAddr) : 0;
++    u_int remaining = (m_transferCurAddr < kSpuExtRamSize) ? (kSpuExtRamSize - m_transferCurAddr) : 0;
+     u_int n = (sizeBytes < remaining) ? sizeBytes : remaining;
+     if (n > 0)
+     {
+@@ -232,7 +233,7 @@ u_int SPUCore::Write(const u_char* src, u_int sizeBytes)
+ 
+ u_int SPUCore::Read(u_char* dst, u_int sizeBytes)
