+#ifdef SH_PC_PORT
+#include <stdlib.h>
+#include "bodyprog/game_boot/fs_chara_anim.h"
+
+/* Creeper-bite hop everywhere. The feet reaction (status_2 ANIM_STATUS(107, *))
+ * only exists in the anim set of maps whose vanilla monsters bite feet, so a
+ * creeper placed anywhere else (remix enemies) found no row and Harry froze.
+ * Borrow it from a map that has it: copy its keyframes out of that map's
+ * HB_M*.ANM to the end of this map's anim data in FS_BUFFER_4, and add a
+ * field_38 row plus a pair of HARRY_BASE_ANIM_INFOS slots pointing at them.
+ * Maps that already carry the rows are left untouched, and with remix enemies
+ * off nothing here runs. */
+#define HOP_ROWS_MAX     40
+#define HOP_KF_MAX       160
+#define HOP_FIRST_SLOT   76
+
+typedef struct
+{
+    int             ready;          /* 1 = loaded, -1 = unavailable this session */
+    int             kfSize;
+    int             kfCount;
+    s32             srcFirstKf;
+    u8*             keyframes;
+    s_UnkStruct3_Mo rows[2];        /* status_2 0xD6 / 0xD7, source keyframe numbering */
+    s_AnimInfo      infos[2][2];    /* [row][blend, playback], source keyframe numbering */
+} s_PcHopSrc;
+
+static s_PcHopSrc      s_hopSrc;
+static s_UnkStruct3_Mo s_hopTable[HOP_ROWS_MAX + 1];
+static s_AnimInfo      s_hopInfos[2][2];
+static int             s_hopActive;
+
+extern unsigned char* Pc_LangReadDiscFile(unsigned int sector, unsigned int size);
+extern unsigned int   Pc_UsaOverlayLinkBase(const void* ovl, int mapIdx);
+
+static unsigned int Pc_HopOvlBase(const u8* ovl, s32 mapIdx)
+{
+    if (g_GameRegion == Region_EUR)
+        return 0x800CB370u;
+    if (g_GameRegion == Region_JPN)
+        return 0x800CBBD0u;
+    return Pc_UsaOverlayLinkBase(ovl, mapIdx);
+}
+
+static int Pc_HopSrcFrom(s32 srcMap, s32 kfSize, s32 firstMapKf)
+{
+    const s_FileInfo* vin = &g_FileTable[FILE_VIN_MAP0_S00_BIN + srcMap];
+    const s_FileInfo* anm = &g_FileTable[FILE_ANIM_HB_M0S00_ANM + srcMap];
+    unsigned int      ovlSize = (unsigned int)vin->blockCount << 8;
+    unsigned int      anmSize = (unsigned int)anm->blockCount << 8;
+    unsigned int      base, tblOff, infOff;
+    u8*               ovl;
+    u8*               anmData;
+    s32               lo = 0x7FFF, hi = -1;
+    int               r, found = 0;
+
+    if (ovlSize < 0x40 || anmSize == 0)
+        return 0;
+    ovl = Pc_LangReadDiscFile(vin->startSector, ovlSize);
+    if (ovl == NULL)
+        return 0;
+
+    base   = Pc_HopOvlBase(ovl, srcMap);
+    tblOff = *(u32*)(ovl + 0x3C) - base;
+    infOff = *(u32*)(ovl + 0x38) - base;
+    if (tblOff >= ovlSize || infOff >= ovlSize)
+    {
+        free(ovl);
+        return 0;
+    }
+
+    for (r = 0; r < HOP_ROWS_MAX && tblOff + (r + 1) * 8 <= ovlSize; r++)
+    {
+        s_UnkStruct3_Mo row;
+        int             which, k;
+
+        memcpy(&row, ovl + tblOff + r * 8, 8);
+        if (row.status == 0)
+            break;
+        if (row.status_2 != ANIM_STATUS(107, true) && row.status_2 != ANIM_STATUS(107, false))
+            continue;
+        which = row.status_2 == ANIM_STATUS(107, true) ? 0 : 1;
+        if (found & (1 << which) || infOff + (2 * r + 2) * 16 > ovlSize)
+            continue;
+
+        s_hopSrc.rows[which] = row;
+        for (k = 0; k < 2; k++)
+        {
+            const u8*   e  = ovl + infOff + (2 * r + k) * 16;
+            s_AnimInfo* ai = &s_hopSrc.infos[which][k];
+
+            if (e[5] != 0) /* variable duration: a function pointer we can't map */
+            {
+                free(ovl);
+                return 0;
+            }
+            if (k == 0)
+                ai->playbackFunc = Anim_BlendLinear;
+            else if (e[6] == 0xFF)
+                ai->playbackFunc = Anim_PlaybackLoop;
+            else
+                ai->playbackFunc = Anim_PlaybackOnce;
+            ai->status              = e[4];
+            ai->hasVariableDuration = false;
+            ai->linkStatus          = e[6];
+            memcpy(&ai->duration.constant, e + 8, 4);
+            memcpy(&ai->startKeyframeIdx, e + 12, 2);
+            memcpy(&ai->endKeyframeIdx, e + 14, 2);
+            if (ai->startKeyframeIdx >= 0 && ai->startKeyframeIdx < lo) lo = ai->startKeyframeIdx;
+            if (ai->endKeyframeIdx > hi) hi = ai->endKeyframeIdx;
+        }
+        if (row.time < lo) lo = row.time;
+        if (row.keyframeIdx_6 > hi) hi = row.keyframeIdx_6;
+        found |= 1 << which;
+    }
+    free(ovl);
+
+    if (found != 3 || lo < firstMapKf || hi < lo || hi - lo + 1 > HOP_KF_MAX ||
+        (u32)(hi - firstMapKf + 1) * kfSize > anmSize)
+        return 0;
+
+    anmData = Pc_LangReadDiscFile(anm->startSector, anmSize);
+    if (anmData == NULL)
+        return 0;
+    s_hopSrc.keyframes = (u8*)malloc((hi - lo + 1) * kfSize);
+    if (s_hopSrc.keyframes == NULL)
+    {
+        free(anmData);
+        return 0;
+    }
+    memcpy(s_hopSrc.keyframes, anmData + (lo - firstMapKf) * kfSize, (hi - lo + 1) * kfSize);
+    free(anmData);
+
+    s_hopSrc.kfSize     = kfSize;
+    s_hopSrc.kfCount    = hi - lo + 1;
+    s_hopSrc.srcFirstKf = lo;
+    SH_DBG("[HOP] feet reaction borrowed from map %d: %d keyframes (%d..%d)", srcMap, s_hopSrc.kfCount, lo, hi);
+    return 1;
+}
+
+static void Pc_HopInfosApply(void)
+{
+    int w, k;
+
+    if (!s_hopActive)
+        return;
+    for (w = 0; w < 2; w++)
+        for (k = 0; k < 2; k++)
+            HARRY_BASE_ANIM_INFOS[s_hopInfos[w][k].status] = s_hopInfos[w][k];
+}
+
+static void Pc_HopInject(s32 mapIdx, s_MapOverlayHdr* hdr)
+{
+    static const s32 SRC_MAPS[] = { MapIdx_MAP1_S02, MapIdx_MAP1_S03, MapIdx_MAP3_S02,
+                                    MapIdx_MAP3_S01, MapIdx_MAP3_S05, MapIdx_MAP5_S00 };
+    const s_AnmHeader* baseHdr = (const s_AnmHeader*)FS_BUFFER_0;
+    u8*                anmBase;
+    u8*                limit;
+    s32                kfSize, firstMapKf, rowCount, infoAnims, appendAt, delta, maxKf, w, k, i;
+    unsigned int       curBytes;
+
+    s_hopActive = 0;
+    /* Only remix enemies puts monsters outside their vanilla maps. */
+    if (!Pc_Remix_EnemiesWanted() || hdr == NULL || hdr->field_38 == NULL || hdr->harryMapAnimInfos == NULL ||
+        mapIdx == MapIdx_MAP6_S04 || mapIdx == MapIdx_MAP7_S01 || mapIdx == MapIdx_MAP7_S02)
+        return;
+
+    for (rowCount = 0; rowCount < HOP_ROWS_MAX && hdr->field_38[rowCount].status != 0; rowCount++)
+        if (hdr->field_38[rowCount].status_2 == ANIM_STATUS(107, true) ||
+            hdr->field_38[rowCount].status_2 == ANIM_STATUS(107, false))
+            return;
+    if (rowCount + 2 >= HOP_ROWS_MAX)
+        return;
+
+    kfSize = baseHdr->keyframeDataSize;
+    if (kfSize <= 0)
+        return;
+    anmBase    = (u8*)FS_BUFFER_0 + baseHdr->dataOffset;
+    firstMapKf = (s32)(((u8*)FS_BUFFER_4 - anmBase) / kfSize);
+    if (anmBase + firstMapKf * kfSize != (u8*)FS_BUFFER_4)
+        return;
+
+    if (s_hopSrc.ready == 0)
+    {
+        s_hopSrc.ready = -1;
+        for (i = 0; i < (s32)ARRAY_SIZE(SRC_MAPS); i++)
+            if (Pc_HopSrcFrom(SRC_MAPS[i], kfSize, firstMapKf))
+            {
+                s_hopSrc.ready = 1;
+                break;
+            }
+        if (s_hopSrc.ready != 1)
+            SH_DBG("[HOP] no map with the feet reaction could be read - bites use the torso reaction");
+    }
+    if (s_hopSrc.ready != 1 || s_hopSrc.kfSize != kfSize)
+        return;
+
+    /* Past everything this map's own anims and its file can reach. */
