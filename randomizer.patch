+              if r['keys'] else 'NULL, 0, NULL, 0')
+        w('    [%d] = { %s, %d, %d, %s, %d, %s }, /* MapIdx_%s */' % (
+            rd.IDX[m], dr, len(r['doors']), r['zones'], pk, r['point_count'], ky, u))
