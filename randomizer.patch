+            {
+                uint8_t taken2[REMIX_MAX_SPOTS];
+                int     d, t, pass2;
+
+                memset(taken2, 0, sizeof(taken2));
+                for (i = 0; i < m->pickupCount; i++)
+                    if (spot[i] != 255)
+                        taken2[spot[i]] = 1;
+                for (pass2 = 0; pass2 < 2; pass2++)
+                    for (i = 0; i < m->pickupCount && i < nSpots; i++)
+                    {
+                        if (spot[i] != 255 || s_xGoneCommon[i])
+                            continue;
+                        if (pass2 == 0)
+                        {
+                            if (!exclude[i] && !taken2[i])
+                                spot[i] = (uint8_t)i, taken2[i] = 1;
+                            continue;
+                        }
+                        for (t = 0; t < nSpots && spot[i] == 255; t++)
+                            if (!exclude[t] && !taken2[t])
+                                spot[i] = (uint8_t)t, taken2[t] = 1;
+                        for (d = 0; d < m->pickupCount && d < nSpots && spot[i] == 255; d++)
+                            if (spot[d] != 255 && spot[d] != d && !exclude[d] && !taken2[d] && !s_xGoneCommon[d])
+                            {
+                                spot[i] = spot[d];
+                                spot[d] = (uint8_t)d;
+                                taken2[d] = 1;
+                            }
+                    }
+                for (i = 0; i < m->pickupCount && i < nSpots; i++)
+                    unplaced |= spot[i] == 255 && !s_xGoneCommon[i];
+                for (i = 0; i < m->pickupCount; i++)
+                    if (spot[i] == i)
+                        spot[i] = 255;
+            }
+        }
+            if (!unplaced || (!keys && (keepHome || !items)))
+                break;
+            /* Prefer one that took a pickup's spot; else any (staying, it may
+             * free the home another key that took a pickup's spot was bound for). */
+            {
+                int j, pref, homeWanted, pick = -1;
+                for (pref = 1; pref >= 0 && pick < 0; pref--)
+                    for (k = m->keyCount < REMIX_MAX_KEYS ? m->keyCount - 1 : REMIX_MAX_KEYS - 1; k >= 0 && pick < 0; k--)
+                    {
+                        if (!s_keys[k].enabled || wide[k] == m->keys[k].slot ||
+                            (pref && m->keySlots[wide[k]].common == 255))
+                            continue;
+                        /* not one whose home another key is bound for */
+                        for (homeWanted = 0, j = 0; j < m->keyCount && j < REMIX_MAX_KEYS; j++)
+                            homeWanted |= j != k && s_keys[j].enabled && wide[j] == m->keys[k].slot &&
+                                          m->keys[j].slot != m->keys[k].slot;
+                        if (!homeWanted)
+                            pick = k;
+                    }
+                k = pick;
+            }
+            /* Still short with every key home (an item from another area took a
+             * spot): the pickups stay home instead of shuffling, so at worst two
+             * lie as close as the map itself puts them. */
+            if (k < 0)
+            {
+                if (keepHome || !items)
+                    break;
+                keepHome = 1;
+                continue;
+            }
+            SH_LOG("[RANDOMIZER] key %s: stays home, so every pickup keeps a spot of its own", m->keys[k].symbol);
+            wide[k]         = m->keys[k].slot;
+            s_keys[k].wide  = m->keys[k].slot;
+            movedKeys--;
+        }
+        {
+            for (i = 0; i < m->pickupCount; i++)
+                if (spot[i] != 255 && spot[i] < m->spotCount)
+                    common_move(i, m->spots[spot[i]].x, m->spots[spot[i]].z,
+                                s_pickupPose[spot[i]] ? &s_pickupPose[spot[i]]->position : NULL,
+                                s_pickupPose[spot[i]] ? &s_pickupPose[spot[i]]->rotation : NULL);
+                else if (spot[i] != 255)
+                {
+                    common_move(i, spotsX[spot[i]].x, spotsX[spot[i]].z, NULL, NULL);
+                    take_place_trigger(m->pickups[i].event, &s_points[m->pickups[i].poi], spotSlot[spot[i]]);
+                    s_commonOnSlot[i] = spotSlot[spot[i]];
+                }
+        }
+        for (i = 0; i < m->pickupCount; i++)
+            movedCommons += s_commonMoved[i];
+    }
+
+    /* What arrived from another area: a pickup row of its own, copied from the
+     * row of the item that was at its spot. */
+    if (s_xArrCount > 0)
+    {
+        int maxFunc = -1, msgCount = Pc_MapMsgCount(mapIdx), nRows = nEvents, a;
+
+        for (i = 0; i < nEvents; i++)
+            if (s_srcEvents[i].sysState == SysState_EventCallback && (int)s_srcEvents[i].eventParam > maxFunc)
+                maxFunc = (int)s_srcEvents[i].eventParam;
+        for (i = 0; i <= maxFunc && i < REMIX_X_MAX_FUNCS - 1; i++)
+            s_xFuncs[i] = src->mapEventFuncs != NULL ? src->mapEventFuncs[i] : NULL;
+        s_xFuncs[maxFunc + 1] = Pc_Remix_XTake;
+        for (i = 0; i < msgCount && i < REMIX_X_MAX_MSGS - REMIX_X_MAX_ARR; i++)
+            s_xMsgs[i] = src->mapMessages != NULL ? ((const char**)src->mapMessages)[i] : "";
+
+        for (a = 0; a < s_xArrCount; a++)
+        {
+            s_RemixXArr*        ar   = &s_xArr[a];
+            const s_RemixXItem* host = ar->host;
+            int                 tRow, tPoi;
+
+            if (host->isKey)
+            {
+                const s_RemixKey* hk  = &m->keys[host->local];
+                void*             sym = MapOverlay_GetSymbol(hk->symbol);
+                tRow = hk->rows[0].event;
+                tPoi = hk->rows[0].poi;
+                if (sym != NULL)
+                {
+                    sym         = (u8*)sym + hk->index * (hk->isPose ? sizeof(s_RemixPose) : sizeof(s_WorldObjectPlacement));
+                    ar->hostPos = &((s_WorldObjectPlacement*)sym)->position;
+                    ar->hostRot = hk->isPose ? &((s_RemixPose*)sym)->rotation : NULL;
+                }
+            }
+            else
+            {
+                tRow = m->pickups[host->local].event;
+                tPoi = m->pickups[host->local].poi;
+                if (s_pickupPose[host->local] != NULL)
+                {
+                    ar->hostPos = &s_pickupPose[host->local]->position;
+                    ar->hostRot = &s_pickupPose[host->local]->rotation;
+                }
+            }
+            if (nRows + 1 >= REMIX_MAX_EVENTS || nextPoi >= REMIX_MAX_POINTS || maxFunc + 1 >= REMIX_X_MAX_FUNCS ||
+                (ar->item->isKey && (msgCount <= 0 || msgCount + a >= REMIX_X_MAX_MSGS)))
+            {
+                SH_LOG("[RANDOMIZER] between areas: no room for an arrived item's pickup on this map");
+                continue;
+            }
+            s_points[nextPoi]                = s_srcPoints[tPoi];
+            s_points[nextPoi].positionX      = host->x;
+            s_points[nextPoi].positionZ      = host->z;
+            s_events[nRows]                  = s_srcEvents[tRow];
+            s_events[nRows].sysState         = SysState_EventCallback;
+            s_events[nRows].eventParam       = (u32)(maxFunc + 1);
+            s_events[nRows].requiredEventFlag = xmap_req(ar->item);
+            s_events[nRows].disabledEventFlag = ar->item->flag;
+            s_events[nRows].pointOfInterestIdx = (u8)nextPoi++;
+            ar->event = nRows++;
+            if (ar->item->isKey)
+            {
+                ar->msg              = msgCount + a;
+                s_xMsgs[ar->msg]     = (s_xHandgunFlag != 0 && ar->item->flag == s_xHandgunFlag) ? REMIX_HANDGUN_MSG
+                                                                                                 : ar->item->takeMsg;
+            }
+        }
+        s_events[nRows] = s_srcEvents[nEvents];
+    }
+
+    messages_behind_pickups(m, nEvents, &nextPoi, &farPoi);
+
+    /* A pickup left on its own spot but of another type is drawn by us too,
+     * with the map's own pose. */
+    for (i = 0; i < m->pickupCount && i < REMIX_MAX_PICKUPS; i++)
+    {
+        s_commonType[i] = (uint8_t)common_type_pick(m->pickups[i].model, m->pickups[i].flag);
+        if (s_commonType[i] == m->pickups[i].model || s_commonMoved[i] || s_xGoneCommon[i])
+            continue;
+        s_commonRetyped[i] = 1;
+        s_commonPos[i]     = s_pickupPose[i] != NULL ? &s_pickupPose[i]->position : NULL;
+        s_commonRot[i]     = s_pickupPose[i] != NULL ? &s_pickupPose[i]->rotation : NULL;
+        s_commonX[i]       = s_srcPoints[m->pickups[i].poi].positionX;
+        s_commonZ[i]       = s_srcPoints[m->pickups[i].poi].positionZ;
+    }
+    for (i = 0; i < m->pickupCount && i < REMIX_MAX_PICKUPS; i++)
+        retyped += s_commonRetyped[i];
+
+    s_origUpdateWorldObjects = (movedCommons || retyped || keys || s_xArrCount > 0 || gone) ? src->updateWorldObjects : NULL;
+
+    s_hdr           = *src;
+    s_hdr.mapEvents = s_events;
+    s_hdr.mapPoints = s_points;
+    if (s_xArrCount > 0)
+    {
+        s_hdr.mapEventFuncs = s_xFuncs;
+        s_hdr.mapMessages   = (void*)s_xMsgs;
+    }
+    if (s_origUpdateWorldObjects != NULL)
+        s_hdr.updateWorldObjects = Pc_Remix_UpdateWorldObjects;
+
+    g_pMapOverlayHeader = &s_hdr;
+    s_active            = 1;
+
+    if (crossGroups)
+        SH_LOG("[RANDOMIZER] %s: rooms across floors: %d door(s) here lead to another floor", MapRegistry_GetName((e_MapIdx)mapIdx),
+               crossDoors);
+    SH_LOG("[RANDOMIZER] %s (seed %llu): rooms %s (%d doors, %d of %d zone(s) rebuilt), "
+           "items %s, keys %s (%d of %d may move); %d pickups moved",
+           MapRegistry_GetName((e_MapIdx)mapIdx), g_RemixCfg.remixSeed,
+           rooms ? "on" : "off", rooms ? m->doorCount : 0, zones, m->zoneCount,
+           items ? "on" : "off", keys ? "on" : "off", movedKeys, m->keyCount, movedCommons);
+    g_RemixLayoutBlocked = NULL;
+}
+
+void Pc_Remix_Init(void)
+{
+    if (g_RemixCfg.remix || g_RemixCfg.remixItems || g_RemixCfg.remixKeys || g_RemixCfg.remixEnemies)
+        SH_LOG("[RANDOMIZER] rooms %s, items %s, keys %s, enemies %s, seed %llu, maps: %s",
+               g_RemixCfg.remix ? "on" : "off", g_RemixCfg.remixItems ? "on" : "off",
+               g_RemixCfg.remixKeys ? "on" : "off", g_RemixCfg.remixEnemies ? "on" : "off",
+               g_RemixCfg.remixSeed, g_RemixCfg.remixMaps[0] ? g_RemixCfg.remixMaps : "all");
+}
diff --git a/pc_port/addons/remix/src/pc_remix_cfg.c b/pc_port/addons/remix/src/pc_remix_cfg.c
new file mode 100644
index 0000000..a250229
--- /dev/null
+++ b/pc_port/addons/remix/src/pc_remix_cfg.c
@@ -0,0 +1,241 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* randomizer.cfg: the add-on keeps its settings out of config.cfg, so removing the
+ * DLL leaves the game's own config exactly as the base game writes it. Same
+ * "key = value" format, so the Randomizer launcher shares the main one's parser. */
+
+#include "pc_remix_cfg.h"
+#include "remix_cfg_template.h"
+#include "sh_log.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define REMIX_CFG_PATH  "randomizer.cfg"
+/* What earlier builds (as "Remix") called it. */
+#define OLD_CFG_PATH    "remix.cfg"
+#define GAME_CFG_PATH   "config.cfg"
+#define REMIX_CFG_LINE  1024
+#define REMIX_CFG_MAX   (256 * 1024)
+
+s_RemixCfg g_RemixCfg = {
+    .remixWeights = { 27, 69, 4, 67, 14, 19 }, /* the vanilla game's own proportions, rounded */
+};
+
+static const char* const WEIGHT_NAMES[6] = { "first_aid", "health_drink", "ampoule",
+                                             "handgun_ammo", "rifle_ammo", "shotgun_ammo" };
+static const char* const ZONE_NAMES[9] = { "outside", "outside_otherworld", "school", "otherworld_school",
+                                           "hospital", "buildings", "nowhere", "park", "sewers" };
+
+static void copy_str(char* dst, size_t cap, const char* src)
+{
+    strncpy(dst, src, cap - 1);
+    dst[cap - 1] = '\0';
+}
+
+static int apply(const char* key, const char* value)
+{
+    int i;
+
+    if (strcmp(key, "remix") == 0)                       g_RemixCfg.remix = atoi(value) != 0;
+    else if (strcmp(key, "remix_items") == 0)            g_RemixCfg.remixItems = atoi(value) != 0;
+    else if (strcmp(key, "remix_keys") == 0)             g_RemixCfg.remixKeys = atoi(value) != 0;
+    else if (strcmp(key, "remix_starter_weapons") == 0)  g_RemixCfg.remixStarterWeapons = atoi(value) != 0;
+    else if (strcmp(key, "remix_weapons") == 0)          g_RemixCfg.remixWeapons = atoi(value) != 0;
+    else if (strcmp(key, "remix_unlockables") == 0)      g_RemixCfg.remixUnlockables = atoi(value) != 0;
+    else if (strcmp(key, "remix_unlockables_always") == 0) g_RemixCfg.remixUnlockablesAlways = atoi(value) != 0;
+    else if (strcmp(key, "remix_enemies") == 0)          g_RemixCfg.remixEnemies = atoi(value) != 0;
+    else if (strcmp(key, "remix_enemies_sewer_scratchers") == 0)
+        g_RemixCfg.remixSewerScratchers = atoi(value) != 0;
+    else if (strcmp(key, "remix_seed") == 0) {
+        unsigned long long v = strtoull(value, NULL, 10);
+        g_RemixCfg.remixSeed = v > REMIX_SEED_MAX ? REMIX_SEED_MAX : v;
+    }
+    else if (strcmp(key, "remix_maps") == 0)
+        copy_str(g_RemixCfg.remixMaps, sizeof(g_RemixCfg.remixMaps), value);
+    else if (strcmp(key, "remix_fixed_items") == 0)
+        copy_str(g_RemixCfg.remixFixedItems, sizeof(g_RemixCfg.remixFixedItems), value);
+    else if (strncmp(key, "remix_weight_", 13) == 0) {
+        int v = atoi(value);
+        for (i = 0; i < 6; i++)
+            if (strcmp(key + 13, WEIGHT_NAMES[i]) == 0)
+                g_RemixCfg.remixWeights[i] = v < 0 ? 0 : (v > 100 ? 100 : v);
+    } else if (strncmp(key, "remix_enemies_", 14) == 0) {
+        for (i = 0; i < 9; i++)
+            if (strcmp(key + 14, ZONE_NAMES[i]) == 0)
+                copy_str(g_RemixCfg.remixEnemyPools[i], sizeof(g_RemixCfg.remixEnemyPools[i]), value);
+    } else
+        return 0;
+    return 1;
+}
+
+static char* trim(char* p)
+{
+    char* e;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    e = p + strlen(p);
+    while (e > p && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n'))
+        *--e = '\0';
+    return p;
+}
+
+/* Splits "key = value" in place; 0 for comments, blanks and lines without '='. */
+static int split(char* line, char** key, char** value)
+{
+    char* p = trim(line);
+    char* eq;
+    if (*p == '#' || *p == ';' || *p == '\0')
+        return 0;
+    eq = strchr(p, '=');
+    if (eq == NULL)
+        return 0;
+    *eq    = '\0';
+    *key   = trim(p);
+    *value = trim(eq + 1);
+    return 1;
+}
+
+/* Returns how many remix keys were read, or -1 when the file is missing. */
+static int parse(const char* path)
+{
+    char  line[REMIX_CFG_LINE];
+    char *key, *value;
+    int   n = 0;
+    FILE* f = fopen(path, "r");
+
+    if (f == NULL)
+        return -1;
+    while (fgets(line, sizeof(line), f))
+        if (split(line, &key, &value) && strncmp(key, "remix", 5) == 0)
+            n += apply(key, value);
+    fclose(f);
+    return n;
+}
+
+/* The documented template, then every value in effect written over its
+ * default, so a migrated config.cfg's settings carry over. */
+static void write_all(void)
+{
+    char  v[32];
+    int   i;
+    FILE* f = fopen(REMIX_CFG_PATH, "wb");
+
+    if (f == NULL) {
+        SH_LOG("[RANDOMIZER] cannot write %s", REMIX_CFG_PATH);
+        return;
+    }
+    fwrite(REMIX_CFG_TEMPLATE, 1, sizeof(REMIX_CFG_TEMPLATE) - 1, f);
+    fclose(f);
+
+#define SAVE_INT(k, x) do { snprintf(v, sizeof(v), "%d", (x)); RemixCfg_SaveKey((k), v); } while (0)
+    SAVE_INT("remix", g_RemixCfg.remix);
+    SAVE_INT("remix_items", g_RemixCfg.remixItems);
+    SAVE_INT("remix_keys", g_RemixCfg.remixKeys);
+    SAVE_INT("remix_starter_weapons", g_RemixCfg.remixStarterWeapons);
+    SAVE_INT("remix_weapons", g_RemixCfg.remixWeapons);
+    SAVE_INT("remix_unlockables", g_RemixCfg.remixUnlockables);
+    SAVE_INT("remix_unlockables_always", g_RemixCfg.remixUnlockablesAlways);
+    SAVE_INT("remix_enemies", g_RemixCfg.remixEnemies);
+    SAVE_INT("remix_enemies_sewer_scratchers", g_RemixCfg.remixSewerScratchers);
+    for (i = 0; i < 6; i++) {
+        char k[48];
+        snprintf(k, sizeof(k), "remix_weight_%s", WEIGHT_NAMES[i]);
+        SAVE_INT(k, g_RemixCfg.remixWeights[i]);
+    }
+#undef SAVE_INT
+    for (i = 0; i < 9; i++) {
+        char k[48];
+        snprintf(k, sizeof(k), "remix_enemies_%s", ZONE_NAMES[i]);
+        RemixCfg_SaveKey(k, g_RemixCfg.remixEnemyPools[i][0] ? g_RemixCfg.remixEnemyPools[i] : "default");
+    }
+    RemixCfg_SaveKey("remix_fixed_items", g_RemixCfg.remixFixedItems);
+    snprintf(v, sizeof(v), "%llu", g_RemixCfg.remixSeed);
+    RemixCfg_SaveKey("remix_seed", v);
+    RemixCfg_SaveKey("remix_maps", g_RemixCfg.remixMaps);
+}
+
+/* Every seed up to REMIX_SEED_MAX fits in 32 bits and is used as is, so a seed
+ * keeps the layout it always had. */
+unsigned int RemixCfg_Seed32(void)
+{
+    unsigned long long s = g_RemixCfg.remixSeed;
+    return (unsigned int)s ^ (unsigned int)(s >> 32) * 0x9E3779B1u;
+}
+
+void RemixCfg_Load(void)
+{
+    int n = parse(REMIX_CFG_PATH);
+
+    if (n >= 0) {
+        SH_LOG("[RANDOMIZER] %s: %d settings", REMIX_CFG_PATH, n);
+        return;
+    }
+    n = parse(OLD_CFG_PATH);
+    if (n >= 0) {
+        write_all();
+        SH_LOG("[RANDOMIZER] %s not found -- created it from %s (%d settings)", REMIX_CFG_PATH, OLD_CFG_PATH, n);
+        return;
+    }
+    n = parse(GAME_CFG_PATH);
+    write_all();
+    SH_LOG("[RANDOMIZER] %s not found -- created it (%d settings taken from %s)",
+           REMIX_CFG_PATH, n > 0 ? n : 0, GAME_CFG_PATH);
+}
+
+void RemixCfg_SaveKey(const char* key, const char* value)
+{
+    char*  buf;
+    char*  out;
+    size_t len = 0, outLen = 0, klen = strlen(key);
+    int    found = 0;
+    FILE*  f = fopen(REMIX_CFG_PATH, "rb");
+
+    buf = (char*)malloc(REMIX_CFG_MAX);
+    out = (char*)malloc(REMIX_CFG_MAX + REMIX_CFG_LINE);
+    if (buf == NULL || out == NULL) {
+        free(buf);
+        free(out);
+        return;
+    }
+    if (f != NULL) {
+        len = fread(buf, 1, REMIX_CFG_MAX - 1, f);
+        fclose(f);
+    }
+    buf[len] = '\0';
+
+    {
+        char* line = buf;
+        while (*line) {
+            char*  nl   = strchr(line, '\n');
+            size_t llen = nl ? (size_t)(nl - line + 1) : strlen(line);
+            const char* p = line;
+            while (*p == ' ' || *p == '\t')
+                p++;
+            if (!found && strncmp(p, key, klen) == 0 &&
+                (p[klen] == ' ' || p[klen] == '\t' || p[klen] == '=')) {
+                outLen += (size_t)snprintf(out + outLen, REMIX_CFG_LINE, "%s = %s\n", key, value);
+                found = 1;
+            } else {
+                memcpy(out + outLen, line, llen);
+                outLen += llen;
+                if (nl == NULL) {
+                    out[outLen++] = '\n';
+                }
+            }
+            line += llen;
+        }
+    }
+    if (!found)
+        outLen += (size_t)snprintf(out + outLen, REMIX_CFG_LINE, "%s = %s\n", key, value);
+
+    f = fopen(REMIX_CFG_PATH, "wb");
+    if (f != NULL) {
+        fwrite(out, 1, outLen, f);
+        fclose(f);
+    } else {
+        SH_LOG("[RANDOMIZER] cannot write %s", REMIX_CFG_PATH);
+    }
+    free(buf);
+    free(out);
+}
diff --git a/pc_port/addons/remix/src/pc_remix_layout.c b/pc_port/addons/remix/src/pc_remix_layout.c
new file mode 100644
index 0000000..1e86e99
--- /dev/null
+++ b/pc_port/addons/remix/src/pc_remix_layout.c
@@ -0,0 +1,640 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Remix mode: room-graph and pickup layout. Pure functions over the generated
+ * tables in pc_remix_data.h -- no game state -- so the same code runs in the game
+ * and in pc_port/tests/remix_layout_test.c. See docs/Randomizer_Mode.md. */
+
+#include "pc_remix_layout.h"
+
+#include <string.h>
+
+typedef struct { uint32_t s; } s_Rng;
+
+static uint32_t rng_next(s_Rng* r)
+{
+    r->s ^= r->s << 13;
+    r->s ^= r->s >> 17;
+    r->s ^= r->s << 5;
+    return r->s;
+}
+
+static int rng_below(s_Rng* r, int n) { return (n <= 0) ? 0 : (int)(rng_next(r) % (uint32_t)n); }
+
+static void rng_seed(s_Rng* r, uint32_t seed, int mapIdx, uint32_t stream)
+{
+    /* splitmix32-style finalizer: nearby seeds and maps give unrelated streams */
+    uint32_t x = seed * 0x9E3779B9u ^ (uint32_t)(mapIdx + 1) * 0x85EBCA6Bu ^ stream;
+    x ^= x >> 16; x *= 0x7FEB352Du;
+    x ^= x >> 15; x *= 0x846CA68Bu;
+    x ^= x >> 16;
+    r->s = x ? x : 0x6D2B79F5u;
+}
+
+static void shuffle_u8(s_Rng* r, uint8_t* a, int n)
+{
+    int i;
+    for (i = n - 1; i > 0; i--)
+    {
+        int j = rng_below(r, i + 1);
+        uint8_t t = a[i]; a[i] = a[j]; a[j] = t;
+    }
+}
+
+static void link(uint8_t* partner, int a, int b)
+{
+    partner[a] = (uint8_t)b;
+    partner[b] = (uint8_t)a;
+}
+
+static uint8_t m_room(const s_RemixMap* maps, const s_RemixDoorRef* refs, int i)
+{
+    return maps[refs[i].map].doors[refs[i].door].room;
+}
+
+/* Pair the leftover stubs of one attempt. No door may lead back into its own
+ * room; a repeated room pair is only accepted if nothing else fits. */
+static int pair_rest(s_Rng* r, const s_RemixDoor* d, uint8_t* stubs, int n, uint8_t* partner)
+{
+    int strict, tries, i, j;
+
+    if (n == 0)
+        return 1;
+
+    for (strict = 1; strict >= 0; strict--)
+    {
+        for (tries = 0; tries < 48; tries++)
+        {
+            int ok = 1;
+            shuffle_u8(r, stubs, n);
+            for (i = 0; i < n && ok; i += 2)
+            {
+                if (d[stubs[i]].room == d[stubs[i + 1]].room)
+                    ok = 0;
+                for (j = 0; j < i && ok && strict; j += 2)
+                {
+                    int a0 = d[stubs[i]].room, a1 = d[stubs[i + 1]].room;
+                    int b0 = d[stubs[j]].room, b1 = d[stubs[j + 1]].room;
+                    if ((a0 == b0 && a1 == b1) || (a0 == b1 && a1 == b0))
+                        ok = 0;
+                }
+            }
+            if (ok)
+            {
+                for (i = 0; i < n; i += 2)
+                    link(partner, stubs[i], stubs[i + 1]);
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+/* One attempt at rebuilding a zone: grow a random spanning tree room by room
+ * (each new room spends one of its doors on a door already in the tree), then pair
+ * whatever doors are left. Rooms with several doors are preferred while only one
+ * tree door is open, so the tree can never run out of doors to attach to. */
+static int build_zone(s_Rng* r, const s_RemixDoor* d, const uint8_t* zoneDoors, int nz, uint8_t* partner)
+{
+    uint8_t roomOf[REMIX_MAX_ROOMS];   /* compact zone room -> room id */
+    uint8_t stubs[REMIX_MAX_ROOMS][REMIX_MAX_DOORS];
+    uint8_t nStub[REMIX_MAX_ROOMS];
+    uint8_t order[REMIX_MAX_ROOMS];
+    uint8_t open[REMIX_MAX_DOORS];
+    int     nRooms = 0, nOpen = 0, nOrder, i, k;
+
+    memset(nStub, 0, sizeof(nStub));
+
+    for (i = 0; i < nz; i++)
+    {
+        int door = zoneDoors[i];
+        for (k = 0; k < nRooms; k++)
+            if (roomOf[k] == d[door].room)
+                break;
+        if (k == nRooms)
+        {
+            if (nRooms >= REMIX_MAX_ROOMS)
+                return 0;
+            roomOf[nRooms++] = d[door].room;
+        }
+        stubs[k][nStub[k]++] = (uint8_t)door;
+    }
+
+    if (nRooms < 2)
+        return 0;
+
+    for (k = 0; k < nRooms; k++)
+    {
+        shuffle_u8(r, stubs[k], nStub[k]);
+        order[k] = (uint8_t)k;
+    }
+    shuffle_u8(r, order, nRooms);
+
+    /* Root: a room with several doors, unless every room has one (then n == 2). */
+    for (i = 0; i < nRooms; i++)
+        if (nStub[order[i]] >= 2)
+            break;
+    if (i == nRooms)
+        i = 0;
+    {
+        uint8_t t = order[0]; order[0] = order[i]; order[i] = t;
+    }
+    for (k = 0; k < nStub[order[0]]; k++)
+        open[nOpen++] = stubs[order[0]][k];
+
+    nOrder = nRooms - 1;
+    {
+        uint8_t* rest = &order[1];
+        while (nOrder > 0)
+        {
+            int pick = rng_below(r, nOrder);
+            int room, s, o;
+
+            if (nOpen == 0)
+                return 0;
+            if (nOpen == 1 && nStub[rest[pick]] < 2)
+            {
+                for (i = 0; i < nOrder; i++)
+                    if (nStub[rest[i]] >= 2)
+                    {
+                        pick = i;
+                        break;
+                    }
+            }
+
+            room = rest[pick];
+            rest[pick] = rest[--nOrder];
+
+            o = rng_below(r, nOpen);
+            s = open[o];
+            open[o] = open[--nOpen];
+            link(partner, s, stubs[room][0]);
+            for (k = 1; k < nStub[room]; k++)
+                open[nOpen++] = stubs[room][k];
+        }
+    }
+
+    if (nOpen & 1)
+        return 0;
+    return pair_rest(r, d, open, nOpen, partner);
+}
+
+int RemixLayout_Doors(const s_RemixMap* m, uint32_t seed, int mapIdx, uint8_t* partner)
+{
+    s_Rng   r;
+    uint8_t zoneDoors[REMIX_MAX_DOORS];
+    int     zone, i, changed = 0;
+
+    for (i = 0; i < m->doorCount; i++)
+        partner[i] = m->doors[i].twin;
+
+    if (m->doorCount > REMIX_MAX_DOORS)
+        return 0;
+
+    rng_seed(&r, seed, mapIdx, 0xD0025u);
+
+    for (zone = 0; zone < m->zoneCount; zone++)
+    {
+        int nz = 0, attempt;
+
+        for (i = 0; i < m->doorCount; i++)
+            if (m->doors[i].zone == zone)
+                zoneDoors[nz++] = (uint8_t)i;
+
+        /* One pair has only one possible wiring. */
+        if (nz <= 2)
+            continue;
+
+        for (attempt = 0; attempt < 64; attempt++)
+        {
+            if (build_zone(&r, m->doors, zoneDoors, nz, partner))
+                break;
+            for (i = 0; i < nz; i++)
+                partner[zoneDoors[i]] = m->doors[zoneDoors[i]].twin;
+        }
+
+        if (attempt < 64)
+        {
+            for (i = 0; i < nz; i++)
+                if (partner[zoneDoors[i]] != m->doors[zoneDoors[i]].twin)
+                {
+                    changed++;
+                    break;
+                }
+        }
+    }
+    return changed;
+}
+
+int RemixLayout_DoorGroup(const s_RemixDoorGroup* g, const s_RemixMap* maps, uint32_t seed, int groupIdx,
+                          s_RemixDoorRef* refs, uint8_t* partner)
+{
+    static s_RemixDoor d[REMIX_MAX_DOORS];
+    uint8_t keyMap[REMIX_MAX_ROOMS * 2], keyRoom[REMIX_MAX_ROOMS * 2], node[REMIX_MAX_ROOMS * 2];
+    uint8_t all[REMIX_MAX_DOORS], setNode[256];
+    int     n = 0, nKeys = 0, i, j, k, attempt;
+    s_Rng   r;
+
+    /* The group's doors, in member order. */
+    for (i = 0; i < g->memberCount; i++)
+    {
+        const s_RemixMap* m = &maps[g->members[i].map];
+        for (j = 0; j < m->doorCount; j++)
+        {
+            if (m->doors[j].zone != g->members[i].zone)
+                continue;
+            if (n >= REMIX_MAX_DOORS)
+                return 0;
+            refs[n].map  = g->members[i].map;
+            refs[n].door = (uint8_t)j;
+            d[n]         = m->doors[j];
+            n++;
+        }
+    }
+    if (n < 3)
+        return 0;
+
+    /* Rooms: one node per (map, room), merge sets joined into one node (sets that
+     * share a room are one too). */
+    for (i = 0; i < n; i++)
+    {
+        for (k = 0; k < nKeys && !(keyMap[k] == refs[i].map && keyRoom[k] == m_room(maps, refs, i)); k++)
+            ;
+        if (k == nKeys)
+        {
+            if (nKeys >= REMIX_MAX_ROOMS * 2)
+                return 0;
+            keyMap[k] = refs[i].map;
+            keyRoom[k] = m_room(maps, refs, i);
+            node[k] = (uint8_t)k;
+            nKeys++;
+        }
+    }
+    memset(setNode, 255, sizeof(setNode));
+    for (i = 0; i < g->mergeCount; i++)
+    {
+        const s_RemixGroupMerge* mg = &g->merges[i];
+        int a = -1;
+        for (k = 0; k < nKeys; k++)
+            if (keyMap[k] == mg->map && keyRoom[k] == mg->room)
+                a = k;
+        if (a < 0)
+            continue;
+        if (setNode[mg->set] == 255)
+            setNode[mg->set] = node[a];
+        else
+        {
+            /* join a's node and the set's node everywhere */
+            uint8_t from = node[a], to = setNode[mg->set];
+            for (k = 0; k < nKeys; k++)
+                if (node[k] == from)
+                    node[k] = to;
+            for (k = 0; k < 256; k++)
+                if (setNode[k] == from)
+                    setNode[k] = to;
+        }
+    }
+    /* compact node ids */
+    {
+        uint8_t remap[REMIX_MAX_ROOMS * 2], nn = 0;
+        memset(remap, 255, sizeof(remap));
+        for (k = 0; k < nKeys; k++)
+        {
+            if (remap[node[k]] == 255)
+            {
+                if (nn >= REMIX_MAX_ROOMS)
+                    return 0;
+                remap[node[k]] = nn++;
+            }
+        }
+        for (i = 0; i < n; i++)
+        {
+            for (k = 0; k < nKeys && !(keyMap[k] == refs[i].map && keyRoom[k] == m_room(maps, refs, i)); k++)
+                ;
+            d[i].room = remap[node[k]];
+        }
+    }
+    /* twins into group indices */
+    for (i = 0; i < n; i++)
+    {
+        int t = maps[refs[i].map].doors[refs[i].door].twin;
+        for (j = 0; j < n && !(refs[j].map == refs[i].map && refs[j].door == t); j++)
+            ;
+        if (j == n)
+            return 0;
+        d[i].twin = (uint8_t)j;
+        all[i] = (uint8_t)i;
+    }
+
+    rng_seed(&r, seed, 0x400 + groupIdx, 0x6C00Fu);
+    for (attempt = 0; attempt < 64; attempt++)
+    {
+        if (build_zone(&r, d, all, n, partner))
+            break;
+        for (i = 0; i < n; i++)
+            partner[i] = d[i].twin;
+    }
+    if (attempt == 64)
+        for (i = 0; i < n; i++)
+            partner[i] = d[i].twin;
+    return n;
+}
+
+void RemixLayout_Pickups(const s_RemixMap* m, uint32_t seed, int mapIdx, uint8_t* spot,
+                         const uint8_t* exclude)
+{
+    s_Rng   r;
+    uint8_t order[REMIX_MAX_SPOTS];
+    uint8_t used[REMIX_MAX_SPOTS];
+    uint8_t roomUsed[256];
+    int     n = m->spotCount, i, k, pass;
+
+    if (n > REMIX_MAX_SPOTS)
+        n = REMIX_MAX_SPOTS;
+
+    rng_seed(&r, seed, mapIdx, 0x17E35u);
+    for (i = 0; i < n; i++)
+        order[i] = (uint8_t)i;
+    shuffle_u8(&r, order, n);
+
+    memset(used, 0, sizeof(used));
+    memset(roomUsed, 0, sizeof(roomUsed));
+    for (i = 0; exclude && i < n; i++)
+        used[i] = exclude[i] ? 1 : 0;
+    for (k = 0; k < m->pickupCount; k++)
+        spot[k] = 255;
+
+    k = 0;
+    for (pass = 0; pass < 2 && k < m->pickupCount; pass++)
+    {
+        for (i = 0; i < n && k < m->pickupCount; i++)
+        {
+            int s = order[i];
+            if (used[s] || (pass == 0 && roomUsed[m->spots[s].room]))
+                continue;
+            used[s] = 1;
+            roomUsed[m->spots[s].room] = 1;
+            spot[k++] = (uint8_t)s;
+        }
+    }
+}
+
+static int pick_slot(s_Rng* r, const uint8_t* ok, int n)
+{
+    int count = 0, i, nth;
+    for (i = 0; i < n; i++)
+        count += ok[i] != 0;
+    if (count == 0)
+        return -1;
+    nth = rng_below(r, count);
+    for (i = 0; i < n; i++)
+        if (ok[i] && nth-- == 0)
+            return i;
+    return -1;
+}
+
+const uint8_t* g_RemixLayoutBlocked;
+
+void RemixLayout_Keys(const s_RemixMap* m, uint32_t seed, int mapIdx,
+                      uint8_t* wide, uint8_t* cell, uint8_t* reserved)
+{
+    s_Rng   r;
+    uint8_t order[REMIX_MAX_KEYS];
+    uint8_t taken[REMIX_MAX_KEYSLOTS];
+    uint8_t ok[REMIX_MAX_KEYSLOTS];
+    int     nk = m->keyCount, ns = m->keySlotCount, i, j, k;
+
+    if (nk > REMIX_MAX_KEYS)
+        nk = REMIX_MAX_KEYS;
+    if (ns > REMIX_MAX_KEYSLOTS)
+        ns = REMIX_MAX_KEYSLOTS;
+
+    memset(reserved, 0, (size_t)ns);
+    for (k = 0; k < nk; k++)
+        wide[k] = cell[k] = m->keys[k].slot;
+
+    rng_seed(&r, seed, mapIdx, 0x4E75u);
+    for (k = 0; k < nk; k++)
+        order[k] = (uint8_t)k;
+    shuffle_u8(&r, order, nk);
+
+    /* Fallback first: a distinct slot in the key's own zone and cell. A swap
+     * key's fallback is its own spot. */
+    memset(taken, 0, sizeof(taken));
+    for (j = 0; g_RemixLayoutBlocked != NULL && j < ns; j++)
+        taken[j] = g_RemixLayoutBlocked[j];
+    for (k = 0; k < nk; k++)
+        if ((m->keys[k].swap || m->keys[k].pinned) && m->keys[k].slot < ns)
+            taken[m->keys[k].slot] = 1;
+    for (i = 0; i < nk; i++)
+    {
+        const s_RemixSlot* home;
+        int pick;
+        k = order[i];
+        if (m->keys[k].slot >= ns || m->keys[k].swap || m->keys[k].pinned)
+            continue;
+        home = &m->keySlots[m->keys[k].slot];
+        for (j = 0; j < ns; j++)
+            ok[j] = !taken[j] && (m->keySlots[j].zone == home->zone || m->keys[k].anywhere) &&
+                    m->keySlots[j].cellX == home->cellX && m->keySlots[j].cellZ == home->cellZ;
+        pick = pick_slot(&r, ok, ns);
+        if (pick < 0)
+            pick = m->keys[k].slot; /* shares its vanilla spot with another key, as in vanilla */
+        cell[k] = (uint8_t)pick;
+        taken[pick] = 1;
+    }
+
+    /* Street keys (`swap`): each goes to a distinct spot among the street keys'
+     * own spots (its own included: it may stay) and the pickups they may trade
+     * with (swapOk).
+     * A key on another street key's spot is fine, since that key has left it;
+     * a key on a pickup's spot sends that pickup to a street key's spot that
+     * nobody took (RemixLayout_KeyDisplaced). There are always exactly as many
+     * of those as displaced pickups. */
+    {
+        uint8_t sk[REMIX_MAX_KEYS], tg[REMIX_MAX_KEYSLOTS], pickT[REMIX_MAX_KEYS];
+        int     nsk = 0, nt = 0, tries, a2;
+
+        for (i = 0; i < nk; i++)
+        {
+            k = order[i];
+            if (m->keys[k].swap && !m->keys[k].pinned && m->keys[k].slot < ns)
+                sk[nsk++] = (uint8_t)k;
+        }
+        for (j = 0; j < ns; j++)
+        {
+            int own = 0;
+            for (a2 = 0; a2 < nsk; a2++)
+                own |= m->keys[sk[a2]].slot == j;
+            if (own || (m->keySlots[j].swapOk && m->keySlots[j].common != 255 && !taken[j]))
+                tg[nt++] = (uint8_t)j;
+        }
+        for (tries = 0; nsk > 0 && tries < 64; tries++)
+        {
+            int good = 1;
+            shuffle_u8(&r, tg, nt);
+            for (a2 = 0; a2 < nsk && good; a2++)
+            {
+                int t;
+                pickT[a2] = 255;
+                for (t = 0; t < nt && pickT[a2] == 255; t++)
+                {
+                    int used = 0, b3;
+                    for (b3 = 0; b3 < a2; b3++)
+                        used |= pickT[b3] == tg[t];
+                    if (!used)
+                        pickT[a2] = tg[t];
+                }
+                good = pickT[a2] != 255;
+            }
+            if (good)
+            {
+                for (a2 = 0; a2 < nsk; a2++)
+                    wide[sk[a2]] = pickT[a2];
+                break;
+            }
+        }
+        for (a2 = 0; a2 < nsk; a2++)
+            taken[wide[sk[a2]]] = 1;
+    }
+
+    /* Wide: anywhere in the zone (or a slot proven reachable while it lies home,
+     * `reach`), never on another key's fallback or wide slot. */
+    for (i = 0; i < nk; i++)
+    {
+        const s_RemixSlot* home;
+        int pick;
+        k = order[i];
+        if (m->keys[k].slot >= ns || m->keys[k].pinned || m->keys[k].swap)
+            continue;
+        home = &m->keySlots[m->keys[k].slot];
+        for (j = 0; j < ns; j++)
+            ok[j] = (!taken[j] || j == cell[k]) &&
+                    (m->keySlots[j].zone == home->zone || m->keys[k].anywhere ||
+                     (j < 64 && ((m->keys[k].reach >> j) & 1))) &&
+                    !(m->keys[k].anywhere && m->keySlots[j].swapOk && j != m->keys[k].slot);
+        pick = pick_slot(&r, ok, ns);
+        wide[k] = (uint8_t)(pick < 0 ? cell[k] : pick);
+        taken[wide[k]] = 1;
+    }
+
+    /* Keys with nowhere free to go but sharing a zone (or all optional on one
+     * map) trade spots among themselves: a random rotation of their own spots,
+     * so a room whose only item spots are its keys' still gets shuffled. Each
+     * spot is left by its owner, so no two keys ever share a wide spot; only a
+     * fallback home can meet the key that took that home. */
+    {
+        uint8_t done[REMIX_MAX_KEYS] = { 0 };
+        int     a;
+
+        for (a = 0; a < nk; a++)
+        {
+            uint8_t grp[REMIX_MAX_KEYS];
+            int     n = 0, b2;
+            const s_RemixSlot* ha;
+
+            if (done[a] || m->keys[a].slot >= ns || m->keys[a].swap || m->keys[a].pinned ||
+                wide[a] != m->keys[a].slot)
+                continue;
+            ha = &m->keySlots[m->keys[a].slot];
+            for (b2 = a; b2 < nk; b2++)
+            {
+                const s_RemixSlot* hb;
+                if (done[b2] || m->keys[b2].slot >= ns || m->keys[b2].swap || m->keys[b2].pinned ||
+                    wide[b2] != m->keys[b2].slot)
+                    continue;
+                hb = &m->keySlots[m->keys[b2].slot];
+                if ((m->keys[a].anywhere && m->keys[b2].anywhere) ||
+                    (!m->keys[a].anywhere && !m->keys[b2].anywhere && hb->zone == ha->zone && ha->zone != REMIX_NO_ZONE))
+                    grp[n++] = (uint8_t)b2;
+            }
+            for (b2 = 0; b2 < n; b2++)
+                done[grp[b2]] = 1;
+            /* Two keys on one vanilla spot gain nothing from trading. */
+            for (b2 = 1; b2 < n; b2++)
+                if (m->keys[grp[b2]].slot == m->keys[grp[0]].slot)
+                    n = 0;
+            if (n < 2)
+                continue;
+            shuffle_u8(&r, grp, n);
+            for (b2 = 0; b2 < n; b2++)
+                wide[grp[b2]] = m->keys[grp[(b2 + 1) % n]].slot;
+        }
+    }
+
+    /* The vanilla spot too: a key waits there until classified, and returns
+     * there as its last fallback. */
+    for (k = 0; k < nk; k++)
+    {
+        reserved[wide[k]] = 1;
+        reserved[cell[k]] = 1;
+        if (m->keys[k].slot < ns)
+            reserved[m->keys[k].slot] = 1;
+    }
+    for (j = 0; g_RemixLayoutBlocked != NULL && j < ns; j++)
+        reserved[j] |= g_RemixLayoutBlocked[j];
+}
+
+void RemixLayout_KeyDisplaced(const s_RemixMap* m, uint32_t seed, int mapIdx,
+                              const uint8_t* reserved, uint8_t* commonSlot)
+{
+    s_Rng   r;
+    uint8_t taken[REMIX_MAX_KEYSLOTS];
+    uint8_t ok[REMIX_MAX_KEYSLOTS];
+    int     ns = m->keySlotCount, s, j;
+
+    if (ns > REMIX_MAX_KEYSLOTS)
+        ns = REMIX_MAX_KEYSLOTS;
+    for (j = 0; j < m->pickupCount; j++)
+        commonSlot[j] = 255;
+
+    rng_seed(&r, seed, mapIdx, 0xD15Bu);
+    memcpy(taken, reserved, (size_t)ns);
+    {
+        uint8_t wide[REMIX_MAX_KEYS], cell[REMIX_MAX_KEYS], res[REMIX_MAX_KEYSLOTS];
+        int     k, nk = m->keyCount < REMIX_MAX_KEYS ? m->keyCount : REMIX_MAX_KEYS;
+
+        /* A swap is a trade: a pickup whose spot a street key took goes to a
+         * street key's own spot that no street key took. */
+        uint8_t vacant[REMIX_MAX_KEYS];
+        int     nv = 0, v = 0, k2;
+
+        RemixLayout_Keys(m, seed, mapIdx, wide, cell, res);
+        for (k = 0; k < nk; k++)
+        {
+            int took = 0;
+            if (!m->keys[k].swap || m->keys[k].pinned || m->keys[k].slot >= ns)
+                continue;
+            for (k2 = 0; k2 < nk; k2++)
+                took |= m->keys[k2].swap && wide[k2] == m->keys[k].slot;
+            if (!took)
+                vacant[nv++] = m->keys[k].slot;
+        }
+        for (k = 0; k < nk; k++)
+        {
+            const s_RemixSlot* sl = &m->keySlots[wide[k]];
+            int onKeyHome = 0;
+            /* On another street key's spot it shares it with whatever lay
+             * there beside that key in vanilla (the Key of Lion's corner has a
+             * pickup of its own). */
+            for (k2 = 0; k2 < nk; k2++)
+                onKeyHome |= m->keys[k2].swap && m->keys[k2].slot == wide[k];
+            if (m->keys[k].swap && !onKeyHome && sl->common < m->pickupCount && v < nv)
+                commonSlot[sl->common] = vacant[v++];
+        }
+    }
+    for (s = 0; s < ns; s++)
+    {
+        const s_RemixSlot* sl = &m->keySlots[s];
+        int pick;
+        if (!reserved[s] || sl->common == 255 || sl->common >= m->pickupCount || commonSlot[sl->common] != 255)
+            continue;
+        /* A slot still holding its own common pickup is only reserved because a
+         * key MIGHT land there; moving the pickup off keeps the two apart. */
+        for (j = 0; j < ns; j++)
+            ok[j] = !taken[j] && m->keySlots[j].zone == sl->zone;
+        pick = pick_slot(&r, ok, ns);
+        if (pick < 0)
+            continue;
+        commonSlot[sl->common] = (uint8_t)pick;
+        taken[pick] = 1;
+    }
+}
diff --git a/pc_port/addons/remix/src/pc_remix_sfx.c b/pc_port/addons/remix/src/pc_remix_sfx.c
new file mode 100644
index 0000000..db0461d
--- /dev/null
+++ b/pc_port/addons/remix/src/pc_remix_sfx.c
@@ -0,0 +1,543 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Remix enemies: each monster keeps its own sounds outside its home maps.
+ *
+ * A monster's sound effects are programs in "the" ambient VAB (libsd slot 2),
+ * and every map loads its own ambient bank there. A monster's SFX ids (the
+ * global g_Vab_InfoTable) name program numbers that only mean the right thing
+ * in the banks of the maps that monster lives in; anywhere else the same
+ * program is some other sound, or nothing.
+ *
+ * Where the borrowed sounds go depends on the sound backend. PsyCross's
+ * legacy OpenAL SPU, and the software SPU with its extended RAM, keep 2 MiB of
+ * sample memory while the game never leaves the PSX's 512 KiB: there each
+ * home bank is loaded whole above 512 KiB at map load, where nothing the game
+ * does can touch it. A software SPU without the extension wraps every address
+ * to 512 KiB (writing there once overwrote BASE.VAB and changed Harry's
+ * footsteps), so with it only the samples a foreign monster's own sound ids
+ * use are packed into the unused tail of the ambient slot (from the end of the
+ * map's own ambient bank up to the music bank's fixed start), under a small
+ * VAB whose VAG size table is rewritten so each packed sample sits where libsd
+ * looks for it; types that don't fit keep the map's own sounds. Which case
+ * applies is probed by asking the SPU for a transfer address above 512 KiB.
+ *
+ * Tail packing waits for the first sound a foreign monster plays (the map's
+ * own ambient bank must be in first, its size decides where the tail starts),
+ * and is redone whenever the ambient bank changes. When a sound is played from a
+ * monster's position (the Sfx_With* entry points, which every monster uses),
+ * the emitter's type is latched; an ambient-bank sound from a foreign monster
+ * then keys on from its borrowed set instead of slot 2. Ground-material
+ * footsteps, Harry's sounds and everything else play exactly as before. */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "game.h"
+#include "bodyprog/bodyprog.h"
+#include "bodyprog/libsd.h"
+#include "bodyprog/sound/sound_system.h"
+#include "main/fileinfo.h"
+#include "sh_log.h"
+#include "pc_remix_sfx_data.h"
+
+extern unsigned char* Pc_LangReadDiscFile(unsigned int sector, unsigned int size);
+extern unsigned long  SpuWrite(unsigned char* addr, unsigned long size);
+extern unsigned long  SpuSetTransferStartAddr(unsigned long addr);
+extern int            Pc_Sd_AmbientState(u16* lastCmd);
+
+#define RSFX_FIRST_VAB 4
+#define RSFX_SLOTS     7
+#define RSFX_CHARAS    64
+#define RSFX_SFX_COUNT 420
+#define RSFX_FILES     8
+#define RSFX_EXT_BASE  0x80000
+#define RSFX_EXT_END   0x200000
+#define RSFX_EXT_REBUILDS 4 /* per map */
+
+/* Each monster family's own sound ids (its character code and its data
+ * tables: the nurse's g_NursePuppetSfxs, the air screamer's sfxVolumes_CE8). */
+typedef struct
+{
+    s8  chara;
+    u16 first, last;
+} s_RsfxRange;
+
+static const s_RsfxRange FAMILY_SFX[] = {
+    { Chara_GreyChild, 1363, 1366 },     { Chara_Mumbler, 1363, 1366 },     { Chara_Stalker, 1363, 1366 },
+    { Chara_LarvalStalker, 1429, 1429 }, { Chara_Creeper, 1424, 1428 },     { Chara_Groaner, 1406, 1414 },
+    { Chara_Wormhead, 1406, 1414 },      { Chara_Romper, 1400, 1405 },      { Chara_PuppetNurse, 1506, 1519 },
+    { Chara_PuppetDoctor, 1506, 1519 },  { Chara_AirScreamer, 1376, 1383 }, { Chara_AirScreamer, 1590, 1590 },
+    { Chara_NightFlutter, 1376, 1383 },  { Chara_NightFlutter, 1590, 1590 }, { Chara_HangedScratcher, 1577, 1584 },
+};
+
+/* Ground-material footsteps (Player_FootstepSfxGet). Several are ambient-bank
+ * sounds that monsters walking on the same ground play too: they're the map's
+ * own surface sounds, so they always play from the map's own bank. */
+static const u16 SURFACE_SFX[] = { 1311, 1312, 1313, 1330, 1331, 1332, 1346, 1388, 1389, 1543, 1557, 1565, 1600, 1608 };
+
+typedef struct
+{
+    int cmd;
+    u8* data; /* whole bank file, so a rebuild after an ambient change needs no disc read */
+    u32 size;
+} s_RsfxFile;
+
+static u8*         s_hdr[RSFX_SLOTS];        /* rewritten VAB headers; libsd keeps pointing at them */
+static s_RsfxFile  s_files[RSFX_FILES];
+static u8          s_need[RSFX_CHARAS];      /* foreign types on this map */
+static int         s_typeCmd[RSFX_CHARAS];   /* home bank per foreign type */
+static s8          s_typeVab[RSFX_CHARAS];   /* libsd VAB id per type once packed, 0 = none */
+static int         s_latchVab;               /* VAB id of the sound's emitter, 0 = none */
+static u8          s_sfxVab[RSFX_SFX_COUNT]; /* VAB id a sound last keyed on from, 0 = its own */
+static int         s_on;
+static int         s_ext; /* sample memory past 512 KiB is real (see top) */
+static int         s_built;
+static const void* s_builtFor; /* the ambient bank the packing was placed after */
+static s32         s_builtSize;
+static u16         s_builtCmd;
+static const s_SubCharacter* s_updating; /* the NPC whose AI update is running (npc_main.c) */
+static int         s_extRebuilds;
+
+static const s_RemixCharaBanks* banks_of(int chara)
+{
+    int i;
+    for (i = 0; i < (int)ARRAY_SIZE(REMIX_CHARA_BANKS); i++)
+        if (REMIX_CHARA_BANKS[i].chara == chara)
+            return &REMIX_CHARA_BANKS[i];
+    return NULL;
+}
+
+static int bank_has(const s_RemixCharaBanks* b, int cmd)
+{
+    int i;
+    for (i = 0; b != NULL && i < b->count; i++)
+        if (b->cmds[i] == cmd)
+            return 1;
+    return 0;
+}
+
+static int is_surface_sfx(int sfxId)
+{
+    int i;
+    for (i = 0; i < (int)ARRAY_SIZE(SURFACE_SFX); i++)
+        if (SURFACE_SFX[i] == sfxId)
+            return 1;
+    return 0;
+}
+
+static int slot_live(int vab)
+{
+    int s = vab - RSFX_FIRST_VAB;
+    return s >= 0 && s < RSFX_SLOTS && s_hdr[s] != NULL && vab_h[vab].vh_addr_4 == (SD_VAB_H*)s_hdr[s];
+}
+
+static void slots_clear(void)
+{
+    int s;
+    for (s = 0; s < RSFX_SLOTS; s++)
+    {
+        if (slot_live(RSFX_FIRST_VAB + s))
+        {
+            vab_h[RSFX_FIRST_VAB + s].vab_id_0  = NO_VALUE;
+            vab_h[RSFX_FIRST_VAB + s].vh_addr_4 = NULL;
+        }
+        free(s_hdr[s]);
+        s_hdr[s] = NULL;
+    }
+    memset(s_typeVab, 0, sizeof(s_typeVab));
+    s_built = 0;
+}
+
+static const s_RsfxFile* file_get(int cmd)
+{
+    const s_AudioItemData* f;
+    u8*                    data;
+    int                    i, slot = -1;
+
+    if (cmd < 160 || cmd >= 160 + 127)
+        return NULL;
+    for (i = 0; i < RSFX_FILES; i++)
+        if (s_files[i].cmd == cmd)
+            return &s_files[i];
+
+    f = &g_AudioData[cmd - 160];
+    if (f->typeIdx_0 != AudioType_Ambient || f->fileSize_4 <= f->vagDataOffset_2)
+        return NULL;
+    data = Pc_LangReadDiscFile((unsigned int)f->fileOffset_8, f->fileSize_4);
+    if (data == NULL || data[0] != 0x70 || ((VabHdr*)data)->ps == 0 || ((VabHdr*)data)->ps > 128 ||
+        f->vagDataOffset_2 < 0xA20 + ((VabHdr*)data)->ps * 0x200)
+    {
+        free(data);
+        SH_DBG("[RANDOMIZER-SFX] bank %d could not be read from the disc", cmd);
+        return NULL;
+    }
+
+    for (i = 0; i < RSFX_FILES && slot < 0; i++)
+        if (s_files[i].cmd == 0)
+            slot = i;
+    if (slot < 0)
+    {
+        slot = 0;
+        free(s_files[0].data);
+    }
+    s_files[slot].cmd  = cmd;
+    s_files[slot].data = data;
+    s_files[slot].size = f->fileSize_4;
+    return &s_files[slot];
+}
+
+/* libsd finds VAG v at the sum of entries 0..v-1 of this u16 table (8-byte units). */
+static u16* vag_table(u8* hdr)
+{
+    return (u16*)(hdr + (((VabHdr*)hdr)->ps << 9) + 0x820);
+}
+
+/* Mark the VAGs a type's sounds play in this bank (indexed like SdVoKeyOn). */
+static void type_vags(const u8* hdr, int chara, u8* want)
+{
+    const SD_VAB_H* vh = (const SD_VAB_H*)hdr;
+    int             k, id, t;
+
+    for (k = 0; k < (int)ARRAY_SIZE(FAMILY_SFX); k++)
+    {
+        if (FAMILY_SFX[k].chara != chara)
+            continue;
+        for (id = FAMILY_SFX[k].first; id <= FAMILY_SFX[k].last; id++)
+        {
+            u16 vp   = g_Vab_InfoTable[id - Sfx_Base].vab_progIdx_2;
+            int prog = vp & 0xFF;
+
+            if ((vp >> 8) != AudioType_Ambient || is_surface_sfx(id) || prog >= vh->vab_h.ps)
+                continue;
+            for (t = 0; t < 16; t++)
+            {
+                int v = vh->vag_atr[prog * 16 + t].vag;
+                if (v > 0 && v <= vh->vab_h.vs)
+                    want[v] = 1;
+            }
+        }
+    }
+}
+
+static u32 want_bytes(const u8* hdr, const u8* want)
+{
+    const u16* tbl = vag_table((u8*)hdr);
+    u32        n   = 0;
+    int        v;
+
+    for (v = 1; v <= ((const VabHdr*)hdr)->vs && v < 256; v++)
+        if (want[v])
+            n += (u32)tbl[v] * 8;
+    return n;
+}
+
+/* Pack the samples of every foreign type homed on `cmd` that still fits under
+ * `limit` into SPU RAM at *spu, as libsd VAB `vab`. */
+static int pack_bank(int cmd, int vab, u32* spu, u32 limit)
+{
+    const s_RsfxFile* f = file_get(cmd);
+    u32               hdrSize, packed, srcOff = 0, dst = 0;
+    u8                want[256], tryWant[256];
+    u8                fits[RSFX_CHARAS];
+    u8*               hdr;
+    u8*               body;
+    u16*              tbl;
+    int               nv, v, c, any = 0;
+
+    if (f == NULL)
+        return 0;
+    hdrSize = g_AudioData[cmd - 160].vagDataOffset_2;
+
+    memset(want, 0, sizeof(want));
+    memset(fits, 0, sizeof(fits));
+    for (c = 0; c < RSFX_CHARAS; c++)
+    {
+        if (!s_need[c] || s_typeCmd[c] != cmd)
+            continue;
+        memcpy(tryWant, want, sizeof(want));
+        type_vags(f->data, c, tryWant);
+        packed = want_bytes(f->data, tryWant);
+        if (packed == 0 || *spu + packed > limit)
+        {
+            SH_DBG("[RANDOMIZER-SFX] chara %d: %u bytes of samples from bank %d don't fit (%u free)", c, packed, cmd,
+                   limit > *spu ? limit - *spu : 0);
+            continue;
+        }
+        memcpy(want, tryWant, sizeof(want));
+        fits[c] = 1;
+        any     = 1;
+    }
+    if (!any)
+        return 0;
+
+    packed = want_bytes(f->data, want);
+    hdr    = (u8*)malloc(hdrSize);
+    body   = (u8*)malloc(packed);
+    if (hdr == NULL || body == NULL)
+    {
+        free(hdr);
+        free(body);
+        return 0;
+    }
+    memcpy(hdr, f->data, hdrSize);
+    tbl = vag_table(hdr);
+    nv  = ((VabHdr*)hdr)->vs;
+    if (nv > 255)
+        nv = 255;
+    for (v = 0; v <= nv; v++)
+    {
+        u32 len = (u32)tbl[v] * 8;
+        if (v > 0 && want[v] && hdrSize + srcOff + len <= f->size)
+        {
+            memcpy(body + dst, f->data + hdrSize + srcOff, len);
+            dst += len;
+        }
+        else
+            tbl[v] = 0;
+        srcOff += len;
+    }
+    ((VabHdr*)hdr)->fsize = 0xA20 + ((VabHdr*)hdr)->ps * 0x200 + dst;
+
+    if (dst == 0 || SdVabFakeHead(hdr, (s16)vab, *spu) != vab)
+    {
+        free(body);
+        free(hdr);
+        return 0;
+    }
+    tone_adsr_mem((s16)vab);
+    SpuSetTransferStartAddr(*spu);
+    SpuWrite(body, dst);
+    free(body);
+    s_hdr[vab - RSFX_FIRST_VAB] = hdr;
+
+    for (c = 0; c < RSFX_CHARAS; c++)
+        if (fits[c])
+        {
+            s_typeVab[c] = (s8)vab;
+            SH_DBG("[RANDOMIZER-SFX] chara %d plays from VAB %d", c, vab);
+        }
+    SH_DBG("[RANDOMIZER-SFX] bank %d: %u bytes of monster samples -> VAB %d at SPU 0x%X", cmd, dst, vab, *spu);
+    *spu = (*spu + dst + 15) & ~15u;
+    return 1;
+}
+
+/* Extended RAM: a home bank whole, at *spu. */
+static int load_bank(int cmd, int vab, u32* spu, u32 limit)
+{
+    const s_RsfxFile* f = file_get(cmd);
+    u32               hdrSize, body;
+    u8*               hdr;
+    int               c;
+
+    if (f == NULL)
+        return 0;
+    hdrSize = g_AudioData[cmd - 160].vagDataOffset_2;
+    body    = f->size - hdrSize;
+    if (*spu + body > limit || (hdr = (u8*)malloc(hdrSize)) == NULL)
+        return 0;
+    memcpy(hdr, f->data, hdrSize);
+    if (SdVabFakeHead(hdr, (s16)vab, *spu) != vab)
+    {
+        free(hdr);
+        return 0;
+    }
+    tone_adsr_mem((s16)vab);
+    SpuSetTransferStartAddr(*spu);
+    SpuWrite(f->data + hdrSize, body);
+    s_hdr[vab - RSFX_FIRST_VAB] = hdr;
+
+    for (c = 0; c < RSFX_CHARAS; c++)
+        if (s_need[c] && s_typeCmd[c] == cmd)
+        {
+            s_typeVab[c] = (s8)vab;
+            SH_DBG("[RANDOMIZER-SFX] chara %d plays from VAB %d", c, vab);
+        }
+    SH_DBG("[RANDOMIZER-SFX] bank %d -> VAB %d at SPU 0x%X (%u bytes)", cmd, vab, *spu, body);
+    *spu = (*spu + body + 15) & ~15u;
+    return 1;
+}
+
+static int ambient_ready(u16* cmd)
+{
+    return !Pc_Sd_AmbientState(cmd) && vab_h[2].vab_id_0 == 2 && vab_h[2].vh_addr_4 != NULL &&
+           vab_h[2].vb_start_addr_10 == D_800A9FDC[AudioType_Ambient] && vab_h[2].vb_size_14 > 0;
+}
+
+static int ambient_same(u16 cmd)
+{
+    return s_builtFor == (const void*)vab_h[2].vh_addr_4 && s_builtSize == vab_h[2].vb_size_14 && s_builtCmd == cmd;
+}
+
+static void build(u16 cmd)
+{
+    u32 spu   = s_ext ? RSFX_EXT_BASE : ((u32)vab_h[2].vb_start_addr_10 + (u32)vab_h[2].vb_size_14 + 15) & ~15u;
+    u32 limit = s_ext ? RSFX_EXT_END : (u32)D_800A9FDC[AudioType_MusicBank];
+    int cmds[RSFX_SLOTS], nCmds = 0, i, c;
+
+    slots_clear();
+    s_builtFor  = vab_h[2].vh_addr_4;
+    s_builtSize = vab_h[2].vb_size_14;
+    s_builtCmd  = cmd;
+    s_built     = 1;
+
+    for (c = 0; c < RSFX_CHARAS; c++)
+    {
+        if (!s_need[c])
+            continue;
+        for (i = 0; i < nCmds && cmds[i] != s_typeCmd[c]; i++)
+            ;
+        if (i == nCmds && nCmds < RSFX_SLOTS)
+            cmds[nCmds++] = s_typeCmd[c];
+    }
+    for (i = 0; i < nCmds && spu < limit; i++)
+    {
+        if (s_ext)
+            load_bank(cmds[i], RSFX_FIRST_VAB + i, &spu, limit);
+        else
+            pack_bank(cmds[i], RSFX_FIRST_VAB + i, &spu, limit);
+    }
+}
+
+void Pc_RemixSfx_Off(void)
+{
+    s_updating    = NULL;
+    s_extRebuilds = 0;
+    slots_clear();
+    memset(s_need, 0, sizeof(s_need));
+    memset(s_sfxVab, 0, sizeof(s_sfxVab));
+    s_latchVab = 0;
+    s_on       = 0;
+    s_ext      = 0;
+}
+
+/* Map load with remix enemies on. `types` are the monster types the pool may
+ * spawn here; `ambientIdx` is the map's own ambientAudioIdx. */
+void Pc_RemixSfx_OnMapLoad(const s8* types, int count, int ambientIdx)
+{
+    int curCmd = (ambientIdx >= 0 && ambientIdx < (int)ARRAY_SIZE(REMIX_AMBIENT_CMDS)) ? REMIX_AMBIENT_CMDS[ambientIdx] : 0;
+    int i, k, c, any = 0;
+
+    Pc_RemixSfx_Off();
+
+    for (i = 0; i < count; i++)
+    {
+        const s_RemixCharaBanks* b = banks_of(types[i]);
+        if (b == NULL || b->count == 0 || bank_has(b, curCmd) || types[i] < 0 || types[i] >= RSFX_CHARAS)
+            continue;
+        s_need[types[i]] = 1;
+        any              = 1;
+    }
+    if (!any)
+        return;
+
+    /* Fewer home banks means fewer files and shared samples packed once. */
+    for (c = 0; c < RSFX_CHARAS; c++)
+    {
+        const s_RemixCharaBanks* b = banks_of(c);
+        int                      bestN = -1;
+
+        if (!s_need[c])
+            continue;
+        for (k = 0; k < b->count; k++)
+        {
+            int o, n = 0;
+            for (o = 0; o < RSFX_CHARAS; o++)
+                n += s_need[o] && bank_has(banks_of(o), b->cmds[k]);
+            if (n > bestN)
+            {
+                bestN        = n;
+                s_typeCmd[c] = b->cmds[k];
+            }
+        }
+        file_get(s_typeCmd[c]);
+    }
+    s_on  = 1;
+    s_ext = SpuSetTransferStartAddr(RSFX_EXT_BASE) != 0;
+    SH_DBG("[RANDOMIZER-SFX] monster samples go %s", s_ext ? "above 512 KiB"
+                                                      : "in the ambient slot's free tail (for room for all of them: "
+                                                        "the Remix launcher's \"More sound memory\", or the PsyCross patch)");
+    if (s_ext)
+        build(0);
+}
+
+void Pc_RemixSfx_Updating(const void* npc)
+{
+    s_updating = (const s_SubCharacter*)npc;
+}
+
+/* Sfx_With* / func_8005D* entry: latch the emitter when the sound is a foreign
+ * monster's. Most play from the monster's own position; some from a point of
+ * their own (the hanged scratcher's claws), which only the monster whose
+ * update is running can have played. */
+void Pc_RemixSfx_Emitter(const VECTOR3* pos)
+{
+    const u8* p = (const u8*)pos;
+    const u8* a = (const u8*)&g_SysWork.npcs[0];
+    const u8* b = (const u8*)&g_SysWork.npcs[ARRAY_SIZE(g_SysWork.npcs)];
+    int       c;
+    u16       cmd;
+
+    s_latchVab = 0;
+    if (!s_on)
+        return;
+    if (p >= a && p < b)
+        c = g_SysWork.npcs[(p - a) / sizeof(s_SubCharacter)].model.charaId;
+    else if (s_updating != NULL && pos != &g_SysWork.playerWork.player.position)
+        c = s_updating->model.charaId;
+    else
+        return;
+    if (c < 0 || c >= RSFX_CHARAS || !s_need[c])
+        return;
+
+    if (!s_ext)
+    {
+        if (!ambient_ready(&cmd))
+            return;
+        if (!s_built || !ambient_same(cmd))
+            build(cmd);
+    }
+    else if (s_typeVab[c] != 0 && !slot_live(s_typeVab[c]) && s_extRebuilds < RSFX_EXT_REBUILDS)
+    {
+        /* Something closed or reused the VAB slot (Sd_AudioStop closes 0-4). */
+        s_extRebuilds++;
+        SH_DBG("[RANDOMIZER-SFX] VAB %d was taken over -- loading the monster banks again", s_typeVab[c]);
+        build(0);
+    }
+    if (slot_live(s_typeVab[c]))
+        s_latchVab = s_typeVab[c];
+}
+
+void Pc_RemixSfx_EmitterClear(void)
+{
+    s_latchVab = 0;
+}
+
+/* Key-on: the (VAB << 8 | program) to play `sfxId` from. */
+u16 Pc_RemixSfx_VabPro(u16 sfxId, u16 vabPro)
+{
+    int idx = sfxId - Sfx_Base;
+
+    if (idx <= 0 || idx >= RSFX_SFX_COUNT)
+        return vabPro;
+    if (s_latchVab != 0 && (vabPro >> 8) == AudioType_Ambient && !is_surface_sfx(sfxId))
+    {
+        s_sfxVab[idx] = (u8)s_latchVab;
+        return (u16)((s_latchVab << 8) | (vabPro & 0xFF));
+    }
+    s_sfxVab[idx] = 0;
+    return vabPro;
+}
+
+/* Key-off: the bank `sfxId` was last keyed on from, if a borrowed one. */
+u16 Pc_RemixSfx_StopVabPro(u16 sfxId, u16 vabPro)
+{
+    int idx = sfxId - Sfx_Base;
+
+    if (idx <= 0 || idx >= RSFX_SFX_COUNT || s_sfxVab[idx] == 0)
+        return vabPro;
+    return (u16)((s_sfxVab[idx] << 8) | (vabPro & 0xFF));
+}
+
+int Pc_RemixSfx_On(void)
+{
+    return s_on;
+}
