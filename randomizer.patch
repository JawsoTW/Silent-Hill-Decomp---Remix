-/* SPDX-License-Identifier: GPL-3.0-or-later */
-/*
- * pc_rando_settings.h - in-game randomizer settings panel.
- *
- * An overlay modelled on the old GL achievement browser (since removed): its own GL
- * program + stb_truetype text, drawn from the post-capture hook, updated on the
- * game thread. Opened in a live run by TAPPING the Map button; HOLDING the Map
- * button opens the real map instead. Navigable by keyboard, controller and mouse.
- */
-#ifndef PC_RANDO_SETTINGS_H
-#define PC_RANDO_SETTINGS_H
-
-/* 1 while the panel owns input (open or animating shut). Gameplay must freeze
- * and yield input to it in that case. */
-int  Pc_RandoSettings_IsOpen(void);
-
-void Pc_RandoSettings_Open(void);
-void Pc_RandoSettings_Close(void);
-
-/* Per-frame input while open (game thread). The caller resolves the signals from
- * the player's own bindings: up/down move the selection, left/right adjust the
- * selected setting, confirm activates an action row, close dismisses (and saves
- * if anything changed). Mouse is read internally. */
-void Pc_RandoSettings_Update(int up, int down, int left, int right, int confirm, int close);
-
-/* Per-frame draw from the post-capture GL hook (cheap no-op while closed). */
-void Pc_RandoSettings_Draw(void);
-
-/* Map-button tap/hold arbiter — call every gameplay frame while a run is live and
- * the panel is closed, passing the Map button's press-edge and held state. A
- * quick tap opens the panel (returns RANDO_MAP_OPENED_SETTINGS); a hold past the
- * threshold returns RANDO_MAP_WANT_MAP so the caller opens the real map screen. */
-enum
-{
-    RANDO_MAP_NONE = 0,
-    RANDO_MAP_OPENED_SETTINGS,
-    RANDO_MAP_WANT_MAP
-};
-int  Pc_RandoSettings_MapButtonArbiter(int mapClicked, int mapHeld);
-
-#endif /* PC_RANDO_SETTINGS_H */
diff --git a/pc_port/include/pc_remix.h b/pc_port/include/pc_remix.h
new file mode 100644
index 0000000..8407365
--- /dev/null
+++ b/pc_port/include/pc_remix.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PC_REMIX_H
+#define PC_REMIX_H
+
+/* The randomizer, called Remix in the code (its first name; config keys
+ * remix_*, in randomizer.cfg). Interiors get a new, fully connected room layout
+ * and their pickups move to new spots; progression doors are untouched. It never
+ * writes map-DLL data: it installs its own copy of the map header with
+ * rewritten event / mapPoint tables. Every entry point is a no-op when it is off.
+ *
+ * See pc_port/docs/Randomizer_Mode.md. */
+
+#include "game.h"
+#include "bodyprog/gfx/world_object.h"
+
+/* Boot: loads the add-on, which reads randomizer.cfg. */
+void Pc_Remix_Init(void);
+
+/* Remix weapons: what a pickup really gives (Event_ItemTake), what an item
+ * add really adds (the cafe's handgun, scripted pickups), and the starting
+ * loadout of a game begun past the cafe. No-ops unless remix_weapons is on. */
+void Pc_Remix_RemapItemTake(s32* itemId, s32* itemCount, s32 eventFlagIdx, s32* mapMsgIdx);
+/* Remix items: the health or ammo type of the common pickup with this flag. */
+u32  Pc_Remix_CommonType(u32 pickupType, s32 flag);
+void Pc_Remix_RemapAddItem(s32* itemId, s32* itemCount);
+void Pc_Remix_StartLoadout(u8* gunId, u8* gunCount, u8* ammoId, u8* ammoCount);
+
+/* The inventory opening: 0 keeps the game from handing over the unlocked
+ * Hyper Blaster, because Remix has it lying in the world or as the starting
+ * gun. 1 (the game's own way) without the add-on or with Remix off.
+ * The engine asks Pc_RemixHyper_Grant (pc_remix_hyper.c); the add-on's own is
+ * Pc_Remix_HyperBlasterGrant, in its table. */
+int  Pc_RemixHyper_Grant(void);
+int  Pc_Remix_HyperBlasterGrant(void);
+/* 1: the Hyper Blaster fires as an unlocked one, though the save has no UFO
+ * ending (remix_unlockables_always put it in the world). 0 without the add-on.
+ * Asked as Pc_RemixHyper_Works; the add-on's own is Pc_Remix_HyperBlasterWorks. */
+int  Pc_RemixHyper_Works(void);
+int  Pc_Remix_HyperBlasterWorks(void);
+
+/* End of GameBoot_MapLoad, after the language patch. */
+void Pc_Remix_OnMapLoad(s32 mapIdx);
+
+/* True when the current map is running a remixed layout. */
+int  Pc_Remix_MapActive(void);
+
+/* True when any randomizer toggle is on. Every
+ * engine hook checks this (or its own toggle) first, so with remix off the
+ * game runs exactly the base code path. */
+int  Pc_Remix_AnyOn(void);
+
+/* GameBoot_MapLoad with remix off: release anything a remixed map left. */
+void Pc_Remix_Off(void);
+
+/* True when this map's monster spawns are being rerolled (remix enemies). */
+int  Pc_Remix_EnemiesOn(void);
+
+/* Remix keys: hide a moved key's original draw (world_draw.c). */
+int  Pc_Remix_ObjectAddFilter(const s_WorldObjectModel* model, const VECTOR3* pos);
+
+/* Gfx_WorldObjectsDraw: moved hospital plates, drawn with their inventory models. */
+void Pc_Remix_WorldDraw(void);
+
+/* Remix enemies: this spawn row's monster type (npc_main.c). */
+void Pc_Remix_EnemyReroll(s32 row, s8* charaId, u8* stateStep);
+
+/* Remix enemies' own sounds (pc_remix_sfx.c). */
+void Pc_RemixSfx_OnMapLoad(const s8* types, int count, int ambientIdx);
+void Pc_RemixSfx_Off(void);
+int  Pc_RemixSfx_On(void);
+void Pc_RemixSfx_Emitter(const VECTOR3* pos);
+void Pc_RemixSfx_EmitterClear(void);
+void Pc_RemixSfx_Updating(const void* npc);
+u16  Pc_RemixSfx_VabPro(u16 sfxId, u16 vabPro);
+u16  Pc_RemixSfx_StopVabPro(u16 sfxId, u16 vabPro);
+
+#endif /* PC_REMIX_H */
diff --git a/pc_port/include/pc_remix_addon.h b/pc_port/include/pc_remix_addon.h
new file mode 100644
index 0000000..7ef3acf
--- /dev/null
+++ b/pc_port/include/pc_remix_addon.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PC_REMIX_ADDON_H
+#define PC_REMIX_ADDON_H
+
+/* The contract between the exe (pc_remix_host.c) and the randomizer add-on DLL
+ * (addons/remix, SilentHillPC_RandomizerAddon.dll / .so). The engine calls the
+ * Pc_Remix_* entry points in pc_remix.h; the host forwards each one to this
+ * table, or does the vanilla thing when the DLL is absent. A DLL built for a
+ * different REMIX_ADDON_API is not used. */
+
+#include "game.h"
+
+#define REMIX_ADDON_API     4
+#define REMIX_ADDON_GETTER  "RemixAddon_Get"
+
+typedef struct {
+    int api;
+    /* Boot, after config.cfg. The DLL reads randomizer.cfg and
+     * adds its PC Options page here. */
+    void (*Init)(void);
+    int  (*AnyOn)(void);
+    void (*OnMapLoad)(s32 mapIdx);
+    void (*Off)(void);
+    int  (*MapActive)(void);
+    int  (*EnemiesOn)(void);
+    /* remix_enemies is set (player_control.c hop rows). */
+    int  (*EnemiesWanted)(void);
+    int  (*ObjectAddFilter)(const s_WorldObjectModel* model, const VECTOR3* pos);
+    void (*WorldDraw)(void);
+    void (*EnemyReroll)(s32 row, s8* charaId, u8* stateStep);
+    u32  (*CommonType)(u32 pickupType, s32 flag);
+    void (*RemapItemTake)(s32* itemId, s32* itemCount, s32 eventFlagIdx, s32* mapMsgIdx);
+    void (*RemapAddItem)(s32* itemId, s32* itemCount);
+    void (*StartLoadout)(u8* gunId, u8* gunCount, u8* ammoId, u8* ammoCount);
+    int  (*SfxOn)(void);
+    void (*SfxEmitter)(const VECTOR3* pos);
+    void (*SfxEmitterClear)(void);
+    void (*SfxUpdating)(const void* npc);
+    u16  (*SfxVabPro)(u16 sfxId, u16 vabPro);
+    u16  (*SfxStopVabPro)(u16 sfxId, u16 vabPro);
+    int  (*HyperBlasterGrant)(void);
+    int  (*HyperBlasterWorks)(void);
+} s_RemixAddon;
+
+typedef const s_RemixAddon* (*RemixAddon_GetFn)(void);
+
+#endif /* PC_REMIX_ADDON_H */
