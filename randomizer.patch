+        }
+        keys = any;
+    }
+    s_keysOn = keys;
+
+    /* Keys that left: their draw is filtered, their pickup rows lead nowhere. */
+    for (k = 0; k < m->keyCount && k < REMIX_MAX_KEYS; k++)
+    {
+        void* sym;
+        int   j;
+        if (!s_xGoneKey[k] || (sym = MapOverlay_GetSymbol(m->keys[k].symbol)) == NULL)
