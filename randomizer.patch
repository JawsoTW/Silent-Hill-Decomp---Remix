-/*
-** Add an integer to list of constants and return its index.
-*/
-static int luaK_intK (FuncState *fs, lua_Integer n) {
-  TValue o;
-  setivalue(&o, n);
-  return addk(fs, &o, &o);  /* use integer itself as key */
-}
