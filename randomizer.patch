-
-static void luaK_float (FuncState *fs, int reg, lua_Number f) {
-  lua_Integer fi;
-  if (luaV_flttointeger(f, &fi, F2Ieq) && fitsBx(fi))
-    codeAsBx(fs, OP_LOADF, reg, cast_int(fi));
-  else
-    luaK_codek(fs, reg, luaK_numberK(fs, f));
-}
