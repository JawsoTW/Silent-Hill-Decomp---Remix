-/*
-** Convert a VKSTR to a VK
-*/
-static void str2K (FuncState *fs, expdesc *e) {
-  lua_assert(e->k == VKSTR);
-  e->u.info = stringK(fs, e->u.strval);
-  e->k = VK;
-}
