+static void xmap_release(int mapGone)
+{
+    int i;
+    for (i = 0; i < REMIX_X_MAX_ARR; i++)
+        if (s_xArr[i].copy.built)
+            copy_release(&s_xArr[i].copy, mapGone);
+    s_xArrCount = 0;
+}
