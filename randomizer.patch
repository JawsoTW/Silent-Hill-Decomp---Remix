+static u32 xmap_rand(u32* st)
+{
+    *st ^= *st << 13;
+    *st ^= *st >> 17;
+    *st ^= *st << 5;
+    return *st;
+}
+
+/* The trades for this seed. Keys only travel when their model can be copied
+ * (resident textures); both areas must be remixed. */
+/* ---------------------------------------------------------------- weapons */
+
