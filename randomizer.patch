-/* Private stream: the game's Rng_* feeds enemy behaviour and demo playback, and
- * drawing from it would desync those. */
-static u32 rnd(void)
-{
-    s_rng ^= s_rng << 13;
-    s_rng ^= s_rng >> 17;
-    s_rng ^= s_rng << 5;
-    return s_rng;
-}
