-                                  const char *p, const char *r) {
-  luaL_Buffer b;
-  luaL_buffinit(L, &b);
-  luaL_addgsub(&b, s, p, r);
-  luaL_pushresult(&b);
-  return lua_tostring(L, -1);
-}
