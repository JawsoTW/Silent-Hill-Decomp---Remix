+/* g_RemixCfg.remixEnemyPools[] index. */
+enum
+{
+    ENEMY_ZONE_OUTSIDE,
+    ENEMY_ZONE_OUTSIDE_OTHERWORLD,
+    ENEMY_ZONE_SCHOOL,
+    ENEMY_ZONE_OTHERWORLD_SCHOOL,
+    ENEMY_ZONE_HOSPITAL,
