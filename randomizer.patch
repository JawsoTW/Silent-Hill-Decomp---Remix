-  else {  /* absolute line information */
-    lua_assert(f->abslineinfo[fs->nabslineinfo - 1].pc == pc);
-    fs->nabslineinfo--;  /* remove it */
-    fs->iwthabs = MAXIWTHABS + 1;  /* force next line info to be absolute */
