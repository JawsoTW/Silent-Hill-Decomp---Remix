-
-void luaK_int (FuncState *fs, int reg, lua_Integer i) {
-  if (fitsBx(i))
-    codeAsBx(fs, OP_LOADI, reg, cast_int(i));
-  else
-    luaK_codek(fs, reg, luaK_intK(fs, i));
-}
