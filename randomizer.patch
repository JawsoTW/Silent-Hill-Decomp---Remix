new file mode 100644
index 0000000..ed77797
--- /dev/null
+++ b/pc_port/build_launcher.bat
@@ -0,0 +1,93 @@
+@echo off
+setlocal
+REM ==========================================================================
+REM  Silent Hill PC Port - build the launcher (SilentHillPC_Launcher.exe)
+REM
+REM  The launcher is a .NET Framework 4.7.2 WinForms app, built with MSBuild,
+REM  separately from the game (build.bat / CMake never touch it). This finds
+REM  MSBuild through vswhere, builds Release, and copies the exe into
+REM  pc_port\build\ next to SilentHillPC.exe.
+REM
+REM  PREREQUISITE (one-time), either of:
+REM    - Visual Studio 2019/2022 with the ".NET desktop development" workload
+REM    - Build Tools for Visual Studio (free), workload ".NET desktop build tools":
+REM        https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2022
+REM  The csc.exe that ships with Windows (C:\Windows\Microsoft.NET\...) is too
+REM  old for this code (C# 5); MSBuild from Visual Studio is required.
+REM
+REM  Override detection with:  set MSBUILD=C:\path\to\MSBuild.exe
+REM
+REM  Usage: build_launcher.bat [output dir] [nofail]
+REM    output dir  where to copy the exe (default pc_port\build)
+REM    nofail      report problems but exit 0 (the CMake build step uses this,
+REM                so a machine without Build Tools still builds the game)
+REM ==========================================================================
+
+set "PCPORT_DIR=%~dp0"
+if "%PCPORT_DIR:~-1%"=="\" set "PCPORT_DIR=%PCPORT_DIR:~0,-1%"
+set "PROJ=%PCPORT_DIR%\launcher\SilentHillPC_Launcher\SilentHillPC_Launcher.csproj"
+set "OUT_EXE=%PCPORT_DIR%\launcher\SilentHillPC_Launcher\bin\Release\SilentHillPC_Launcher.exe"
+set "BUILD_DIR=%PCPORT_DIR%\build"
+if not "%~1"=="" set "BUILD_DIR=%~1"
+set "NOFAIL="
+if /i "%~2"=="nofail" set "NOFAIL=1"
+
+if defined MSBUILD if exist "%MSBUILD%" goto have_msbuild
+
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if not exist "%VSWHERE%" (
+    echo ERROR: Visual Studio / Build Tools not found ^(no vswhere.exe^).
+    echo Install "Build Tools for Visual Studio" with the ".NET desktop build tools" workload:
+    echo   https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2022
+    echo or set MSBUILD to the full path of MSBuild.exe.
+    goto fail
+)
+set "MSBUILD="
+for /f "usebackq delims=" %%M in (`"%VSWHERE%" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe`) do (
+    if not defined MSBUILD set "MSBUILD=%%M"
+)
+if not defined MSBUILD (
+    echo ERROR: Visual Studio is installed but MSBuild was not found.
+    echo Add the ".NET desktop build tools" workload in the Visual Studio Installer.
+    goto fail
+)
+
+:have_msbuild
+echo === Building launcher with "%MSBUILD%" ===
+REM No lingering MSBuild worker nodes or VBCSCompiler server: either keeps the
+REM console/pipe handles of whoever started the build open after MSBuild exits,
+REM so a build step that waits for its output to close (ninja) never finishes.
+set "MSBUILDDISABLENODEREUSE=1"
+REM Files from a downloaded zip carry the "mark of the web", and MSBuild then
+REM refuses the .resx files (MSB3821). Clear it on the launcher sources first.
+powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -LiteralPath '%PCPORT_DIR%launcher' -Recurse -File | Unblock-File" >nul 2>&1
+"%MSBUILD%" "%PROJ%" /nologo /v:minimal /nodeReuse:false /p:UseSharedCompilation=false /p:Configuration=Release /p:Platform=AnyCPU
+if errorlevel 1 (
+    echo Launcher build failed.
+    echo If it reports a missing .NET Framework 4.7.2 targeting pack, add
+    echo ".NET Framework 4.7.2 targeting pack" in the Visual Studio Installer.
+    goto fail
+)
+if not exist "%OUT_EXE%" (
+    echo ERROR: MSBuild finished but "%OUT_EXE%" was not produced.
+    goto fail
+)
+
+if not exist "%BUILD_DIR%" mkdir "%BUILD_DIR%"
+REM The launcher replaces its own exe on update; it must not be running.
+tasklist /fi "imagename eq SilentHillPC_Launcher.exe" 2>nul | find /i "SilentHillPC_Launcher.exe" >nul
+if not errorlevel 1 (
+    echo ERROR: SilentHillPC_Launcher.exe is running - close it, then run this again.
+    goto fail
+)
+copy /y "%OUT_EXE%" "%BUILD_DIR%\" >nul
+if errorlevel 1 ( echo ERROR: could not copy the launcher into "%BUILD_DIR%". & goto fail )
+echo Launcher: %BUILD_DIR%\SilentHillPC_Launcher.exe
+endlocal & exit /b 0
+
+:fail
+if defined NOFAIL (
+    echo WARNING: SilentHillPC_Launcher.exe was not built - the game itself is fine.
+    endlocal & exit /b 0
+)
+endlocal & exit /b 1
diff --git a/pc_port/build_randomizer_launcher.bat b/pc_port/build_randomizer_launcher.bat
new file mode 100644
index 0000000..1910da3
--- /dev/null
+++ b/pc_port/build_randomizer_launcher.bat
@@ -0,0 +1,93 @@
+@echo off
+setlocal
+REM ==========================================================================
+REM  Silent Hill PC Port - build the Randomizer launcher (SilentHillPC_Randomizer.exe)
+REM
+REM  The Randomizer launcher is a .NET Framework 4.7.2 WinForms app, built with MSBuild,
+REM  separately from the game (build.bat / CMake never touch it). This finds
+REM  MSBuild through vswhere, builds Release, and copies the exe into
+REM  pc_port\build\ next to SilentHillPC.exe.
+REM
+REM  PREREQUISITE (one-time), either of:
+REM    - Visual Studio 2019/2022 with the ".NET desktop development" workload
+REM    - Build Tools for Visual Studio (free), workload ".NET desktop build tools":
+REM        https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2022
+REM  The csc.exe that ships with Windows (C:\Windows\Microsoft.NET\...) is too
+REM  old for this code (C# 5); MSBuild from Visual Studio is required.
+REM
+REM  Override detection with:  set MSBUILD=C:\path\to\MSBuild.exe
+REM
+REM  Usage: build_randomizer_launcher.bat [output dir] [nofail]
+REM    output dir  where to copy the exe (default pc_port\build)
+REM    nofail      report problems but exit 0 (the CMake build step uses this,
+REM                so a machine without Build Tools still builds the game)
+REM ==========================================================================
+
+set "PCPORT_DIR=%~dp0"
+if "%PCPORT_DIR:~-1%"=="\" set "PCPORT_DIR=%PCPORT_DIR:~0,-1%"
+set "PROJ=%PCPORT_DIR%\launcher\SilentHillPC_Remix\SilentHillPC_Remix.csproj"
+set "OUT_EXE=%PCPORT_DIR%\launcher\SilentHillPC_Remix\bin\Release\SilentHillPC_Randomizer.exe"
+set "BUILD_DIR=%PCPORT_DIR%\build"
+if not "%~1"=="" set "BUILD_DIR=%~1"
+set "NOFAIL="
+if /i "%~2"=="nofail" set "NOFAIL=1"
+
+if defined MSBUILD if exist "%MSBUILD%" goto have_msbuild
+
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if not exist "%VSWHERE%" (
+    echo ERROR: Visual Studio / Build Tools not found ^(no vswhere.exe^).
+    echo Install "Build Tools for Visual Studio" with the ".NET desktop build tools" workload:
+    echo   https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2022
+    echo or set MSBUILD to the full path of MSBuild.exe.
+    goto fail
+)
+set "MSBUILD="
+for /f "usebackq delims=" %%M in (`"%VSWHERE%" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe`) do (
+    if not defined MSBUILD set "MSBUILD=%%M"
+)
+if not defined MSBUILD (
+    echo ERROR: Visual Studio is installed but MSBuild was not found.
+    echo Add the ".NET desktop build tools" workload in the Visual Studio Installer.
+    goto fail
+)
+
+:have_msbuild
+echo === Building the Randomizer launcher with "%MSBUILD%" ===
+REM No lingering MSBuild worker nodes or VBCSCompiler server: either keeps the
+REM console/pipe handles of whoever started the build open after MSBuild exits,
+REM so a build step that waits for its output to close (ninja) never finishes.
+set "MSBUILDDISABLENODEREUSE=1"
+REM Files from a downloaded zip carry the "mark of the web", and MSBuild then
+REM refuses the .resx files (MSB3821). Clear it on the launcher sources first.
+powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -LiteralPath '%PCPORT_DIR%launcher' -Recurse -File | Unblock-File" >nul 2>&1
+"%MSBUILD%" "%PROJ%" /nologo /v:minimal /nodeReuse:false /p:UseSharedCompilation=false /p:Configuration=Release /p:Platform=AnyCPU
+if errorlevel 1 (
+    echo Randomizer launcher build failed.
+    echo If it reports a missing .NET Framework 4.7.2 targeting pack, add
+    echo ".NET Framework 4.7.2 targeting pack" in the Visual Studio Installer.
+    goto fail
+)
+if not exist "%OUT_EXE%" (
+    echo ERROR: MSBuild finished but "%OUT_EXE%" was not produced.
+    goto fail
+)
+
+if not exist "%BUILD_DIR%" mkdir "%BUILD_DIR%"
+REM It can't be overwritten while it is open.
+tasklist /fi "imagename eq SilentHillPC_Randomizer.exe" 2>nul | find /i "SilentHillPC_Randomizer.exe" >nul
+if not errorlevel 1 (
+    echo ERROR: SilentHillPC_Randomizer.exe is running - close it, then run this again.
+    goto fail
+)
+copy /y "%OUT_EXE%" "%BUILD_DIR%\" >nul
+if errorlevel 1 ( echo ERROR: could not copy the launcher into "%BUILD_DIR%". & goto fail )
+echo Randomizer launcher: %BUILD_DIR%\SilentHillPC_Randomizer.exe
+endlocal & exit /b 0
+
+:fail
+if defined NOFAIL (
+    echo WARNING: SilentHillPC_Randomizer.exe was not built - the game itself is fine.
+    endlocal & exit /b 0
+)
+endlocal & exit /b 1
diff --git a/pc_port/cmake/build_launcher.cmake b/pc_port/cmake/build_launcher.cmake
new file mode 100644
index 0000000..a307bd9
--- /dev/null
+++ b/pc_port/cmake/build_launcher.cmake
@@ -0,0 +1,35 @@
+# Runs build_launcher.bat for the SilentHillPC_Launcher build step.
+#   cmake -DBAT=<build_launcher.bat> -DOUT_DIR=<build dir> -DSTAMP=<stamp file> -P build_launcher.cmake
+#
+# Started through cmake.exe rather than as `cmd /c ...` in the build rule: under
+# an MSYS2 shell, MSYS rewrites a bare "/c" argument into the path "C:/", which
+# leaves cmd.exe sitting at an interactive prompt and the build hangs on step 1.
+# execute_process passes arguments to cmd.exe untouched. stdin comes from NUL so
+# nothing can ever wait for input, and a timeout stops a stuck MSBuild from
+# holding the game build forever. Never fails the build: the game doesn't need
+# the launcher.
+
+file(TO_NATIVE_PATH "${BAT}" _bat)
+file(TO_NATIVE_PATH "${OUT_DIR}" _out)
+if(WIN32 OR CMAKE_HOST_WIN32)
+    set(_null NUL)
+else()
+    set(_null /dev/null)
+endif()
+
+# An MSYS-built cmake would still rewrite "/d" and "/c" when it starts cmd.exe;
+# this tells the MSYS runtime to leave every argument alone.
+set(ENV{MSYS2_ARG_CONV_EXCL} "*")
+set(ENV{MSBUILDDISABLENODEREUSE} "1")
+
+execute_process(
+    COMMAND cmd.exe /d /c "${_bat}" "${_out}" nofail
+    INPUT_FILE "${_null}"
+    RESULT_VARIABLE _rc
+    TIMEOUT 600)
+
+if(NOT _rc EQUAL 0)
+    message(WARNING "SilentHillPC_Launcher.exe was not built (${_rc}). The game itself is fine; "
+                    "run pc_port\\build_launcher.bat by hand to see why.")
+endif()
+file(TOUCH "${STAMP}")
diff --git a/pc_port/cmake/copy_mingw_runtime.cmake b/pc_port/cmake/copy_mingw_runtime.cmake
new file mode 100644
index 0000000..1999662
--- /dev/null
+++ b/pc_port/cmake/copy_mingw_runtime.cmake
@@ -0,0 +1,82 @@
+# Copy the MinGW runtime DLLs a built binary needs (libgcc_s_seh-1.dll,
+# libwinpthread-1.dll, libstdc++-6.dll, SDL2.dll, OpenAL, libjpeg, ...) next to
+# it, so SilentHillPC.exe starts from Explorer, build.bat run or the launcher
+# without C:\msys64\mingw64\bin on PATH.
+#
+# Walks the import tables with objdump, recursively, and copies only DLLs that
+# exist in the toolchain's bin directory; Windows system DLLs never match and
+# are left alone. Map DLLs in maps/ are scanned too: Windows resolves a loaded
+# DLL's own imports from the exe's directory, so one copy there serves them.
+#
+#   cmake -DBINARY=<exe> -DSEARCH_DIR=<mingw64/bin> -DOBJDUMP=<objdump> [-DEXTRA_GLOB=<glob>] -P copy_mingw_runtime.cmake
+
+cmake_minimum_required(VERSION 3.16)
+
+if(NOT BINARY OR NOT SEARCH_DIR OR NOT OBJDUMP)
+    message(FATAL_ERROR "copy_mingw_runtime: BINARY, SEARCH_DIR and OBJDUMP are required")
+endif()
+
+get_filename_component(_dest "${BINARY}" DIRECTORY)
+
+set(_queue "${BINARY}")
+if(EXTRA_GLOB)
+    file(GLOB _extra "${EXTRA_GLOB}")
+    list(APPEND _queue ${_extra})
+endif()
+
+set(_seen "")
+set(_copied 0)
+
+# Lower-cased index of the toolchain's bin dir, built once: import tables spell
+# names in whatever case the import library used.
+file(GLOB _avail "${SEARCH_DIR}/*")
+set(_availKeys "")
+foreach(_a IN LISTS _avail)
+    get_filename_component(_an "${_a}" NAME)
+    string(TOLOWER "${_an}" _an)
+    list(APPEND _availKeys "${_an}")
+endforeach()
+
+while(_queue)
+    list(GET _queue 0 _bin)
+    list(REMOVE_AT _queue 0)
+
+    execute_process(COMMAND "${OBJDUMP}" -p "${_bin}"
+                    OUTPUT_VARIABLE _dump ERROR_QUIET RESULT_VARIABLE _rc)
+    if(NOT _rc EQUAL 0)
+        continue()
+    endif()
+
+    string(REGEX MATCHALL "DLL Name: [^\r\n]+" _names "${_dump}")
+    foreach(_line IN LISTS _names)
+        string(REGEX REPLACE "^DLL Name: " "" _dll "${_line}")
+        string(STRIP "${_dll}" _dll)
+        string(TOLOWER "${_dll}" _key)
+        if(_key IN_LIST _seen)
+            continue()
+        endif()
+        list(APPEND _seen "${_key}")
+
+        list(FIND _availKeys "${_key}" _idx)
+        if(_idx LESS 0)
+            continue()
+        endif()
+        list(GET _avail ${_idx} _src)
+
+        get_filename_component(_name "${_src}" NAME)
+        set(_differs 1)
+        if(EXISTS "${_dest}/${_name}")
+            execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${_src}" "${_dest}/${_name}"
+                            RESULT_VARIABLE _differs OUTPUT_QUIET ERROR_QUIET)
+        endif()
+        if(NOT _differs EQUAL 0)
+            file(COPY "${_src}" DESTINATION "${_dest}")
+            math(EXPR _copied "${_copied} + 1")
+        endif()
+        list(APPEND _queue "${_src}")
+    endforeach()
+endwhile()
+
+if(_copied GREATER 0)
+    message(STATUS "copy_mingw_runtime: copied ${_copied} runtime DLL(s) to ${_dest}")
+endif()
