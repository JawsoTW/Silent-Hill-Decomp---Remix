-
-#include <stdio.h>
-#include <string.h>
-#include <stdlib.h>
-
-#define RANDO_CFG_PATH "gamedata/randomizer.cfg"
-
-static const s_RandoConfig RANDO_DEFAULTS = {
-    .spawnDensity    = 100,
-    .monsterMax      = 30,
-    .areasToBoss     = 10,
-    .entryLockSec    = 10,
-    .enemyHealthPct  = 100,
-    .weaponDamagePct = 100,
